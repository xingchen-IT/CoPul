<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 本机处国内网络，统一走华为云镜像；各子工程自带的 NuGet.config 仍保留，互不影响 -->
  <packageSources>
    <clear />
    <add key="huawei-mirror" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
