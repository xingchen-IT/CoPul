<Window x:Class="CoPul.App.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoPul 芯脉 · 悬浮窗"
        Height="34" SizeToContent="Width"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" AllowsTransparency="False"
        Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        6.1 形态：无标题栏、无边框按钮、单行圆角长条。
        AllowsTransparency 必须保持 False —— 开了会变成 layered window，DWM 的系统背景
        直接失效、WPF 还会退掉硬件加速（A-30 同源）。背景靠 WindowGlass 把
        Window.Background 与 CompositionTarget.BackgroundColor 一起刷透明来解决。

        底色的实际值由代码按「主题 × 浓度档」算出来（FloatWindow.ApplyGlass），
        XAML 这里只是打开瞬间的初值：浅色 16% 白。
        着色分两层：accent 的 tint（WindowGlass）+ 这里的 Shell 遮罩，
        两层相乘才是"遮住背景"的总量。浅色档系统自带约 85% 白底，所以浓度主要靠 Shell 拉。
    -->
    <Border x:Name="Shell" Height="34" CornerRadius="10" BorderThickness="1"
            BorderBrush="{StaticResource BrushGlassEdge}" Background="{StaticResource BrushGlassTint}"
            Padding="10,0"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown"
            MouseRightButtonUp="Shell_MouseRightButtonUp"
            MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示大窗口" Click="ShowMain_Click" />

                <MenuItem x:Name="LockMenu" Header="锁定位置" IsCheckable="True"
                          Click="ToggleLock_Click"
                          ToolTip="锁定后拖动无效，防止误碰挪走（6.5）" />

                <Separator />

                <!-- 单选靠代码互斥（WPF 菜单没有现成的 RadioMenuItem） -->
                <MenuItem Header="外观">
                    <MenuItem x:Name="ThemeLightMenu" Header="浅色玻璃" IsCheckable="True" IsChecked="True"
                              Click="ThemeLight_Click" />
                    <MenuItem x:Name="ThemeDarkMenu" Header="深色玻璃" IsCheckable="True"
                              Click="ThemeDark_Click" />
                </MenuItem>

                <MenuItem Header="浓度">
                    <MenuItem x:Name="Level1Menu" Header="极透（无模糊）" IsCheckable="True" Click="Level_Click" Tag="1" />
                    <MenuItem x:Name="Level2Menu" Header="很透" IsCheckable="True" Click="Level_Click" Tag="2" />
                    <MenuItem x:Name="Level3Menu" Header="较透" IsCheckable="True" Click="Level_Click" Tag="3" />
                    <MenuItem x:Name="Level4Menu" Header="适中" IsCheckable="True" IsChecked="True"
                              Click="Level_Click" Tag="4" />
                    <MenuItem x:Name="Level5Menu" Header="较实" IsCheckable="True" Click="Level_Click" Tag="5" />
                    <MenuItem x:Name="Level6Menu" Header="很实" IsCheckable="True" Click="Level_Click" Tag="6" />
                    <MenuItem x:Name="Level7Menu" Header="极实" IsCheckable="True" Click="Level_Click" Tag="7" />
                </MenuItem>

                <MenuItem x:Name="GlassMenu" Header="毛玻璃" IsCheckable="True" IsChecked="True"
                          Click="ToggleGlass_Click" />

                <!-- 6.6 的菜单结构里这两项 v1 就有，但功能不在 v1 范围：
                     悬浮窗六字段必须全显（Q-03），设置页排在 M4。留成置灰项而不是直接删掉，
                     是为了让菜单结构和需求对得上，也避免以后加回来时改结构。 -->
                <MenuItem Header="显示字段" IsEnabled="False"
                          ToolTip="v1 全部常显，不提供隐藏（Q-03）" />
                <MenuItem Header="设置…" IsEnabled="False"
                          ToolTip="设置页在 M4 提供" />

                <Separator />
                <MenuItem Header="退出" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <!-- 列宽严格照 6.3：34 / 44 / 44 / 74 / 78 / 44，间距 8，两端内边距各 10 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <StackPanel Width="{Binding FloatFps.Width}" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FloatValue}" Text="{Binding FloatFps.Top}"
                           Foreground="{Binding FloatFps.TopBrush}" />
                <TextBlock Style="{StaticResource FloatLabel}" Text="{Binding FloatFps.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatCpu.Width}" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FloatValue}" Text="{Binding FloatCpu.Top}"
                           Foreground="{Binding FloatCpu.TopBrush}" />
                <TextBlock Style="{StaticResource FloatLabel}" Text="{Binding FloatCpu.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatGpu.Width}" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FloatValue}" Text="{Binding FloatGpu.Top}"
                           Foreground="{Binding FloatGpu.TopBrush}" />
                <TextBlock Style="{StaticResource FloatLabel}" Text="{Binding FloatGpu.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatRam.Width}" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FloatValue}" Text="{Binding FloatRam.Top}"
                           Foreground="{Binding FloatRam.TopBrush}" />
                <TextBlock Style="{StaticResource FloatLabel}" Text="{Binding FloatRam.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatVram.Width}" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FloatValue}" Text="{Binding FloatVram.Top}"
                           Foreground="{Binding FloatVram.TopBrush}" />
                <TextBlock Style="{StaticResource FloatLabel}" Text="{Binding FloatVram.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatNet.Width}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FloatValue}" Text="{Binding FloatNet.Top}"
                           Foreground="{Binding FloatNet.TopBrush}" />
                <TextBlock Style="{StaticResource FloatLabel}" Text="{Binding FloatNet.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
