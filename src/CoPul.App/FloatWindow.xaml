<!--
    ShowActivated=False（M4.22）：Show() 不抢前台，要前台时由调用方显式 Activate()。
    全屏自动切到悬浮窗时必须不抢 —— 前台是游戏，抢过来等于把键鼠从游戏里抽走；
    窗口自己是 topmost，不激活也照样在最上面。手动切视图那条路会显式 Activate()。
-->
<Window x:Class="CoPul.App.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoPul 芯脉 · 悬浮窗"
        Height="34" SizeToContent="Width"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" AllowsTransparency="True"
        ShowActivated="False"
        Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Q-05 三档缩放（100 / 125 / 150）的落点。

        做法是**改 DIP 字面值后重新布局**，不是套 Viewbox / LayoutTransform。
        Viewbox 的语义是"先按 13 DIP 排好版，再把结果整体放大"，文字会被当作位图拉伸；
        本项目所在屏本身就是 150% DPI，再乘 1.5 档等于 2.25 倍像素比，边缘会明显发虚。
        改 DIP 则是让 WPF 用目标尺寸重新排版，矢量文字在任何档位都锐利。

        因为 FloatValue / FloatLabel 是 App 级的共享样式（大窗口也可能用），
        这里用 BasedOn 派生两个只在本窗口生效的副本，把 FontSize / LineHeight
        改成绑到窗口上的一组依赖属性。局部值优先于 Style setter，所以不冲突。
    -->
    <Window.Resources>
        <Style x:Key="FloatValueScaled" TargetType="TextBlock" BasedOn="{StaticResource FloatValue}">
            <Setter Property="FontSize"
                    Value="{Binding ValueFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="LineHeight"
                    Value="{Binding ValueLineHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <Style x:Key="FloatLabelScaled" TargetType="TextBlock" BasedOn="{StaticResource FloatLabel}">
            <Setter Property="FontSize"
                    Value="{Binding LabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="LineHeight"
                    Value="{Binding LabelLineHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <!--
            竖向专用：文字在格宽内水平居中（M4.12）。

            为什么单开一套：RowPanel 的六格宽度按内容定（34/44/44/74/78/44），左对齐正好
            贴着格左缘，横排读起来是一"串"数据。竖排时六格被 Grid 的 Auto 列拉到同一宽度，
            左对齐会让短数据右侧空出一大片（"22%" 缩在左上角），看着像没对齐的碎片。

            为什么必须连 Stretch 一起写：FloatValue / FloatLabel 基样式写死了
            HorizontalAlignment=Left，TextBlock 只占内容宽（宽 = 文字宽），而 TextAlignment
            管的是"在自身宽度内怎么摆" —— 框和文字一样宽时，Center 等于没设置（编译不报错、
            运行不报错，只是静默无效）。Stretch 把框拉到列宽，居中才有作用对象。

            列宽不受影响：Auto 列在测量阶段按期望宽取最大，Stretch 那时退化为内容宽；
            它只在排列阶段生效，所以窗口宽度仍是"最长那句"决定的 47 DIP。
        -->
        <Style x:Key="FloatValueCentered" TargetType="TextBlock" BasedOn="{StaticResource FloatValueScaled}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="FloatLabelCentered" TargetType="TextBlock" BasedOn="{StaticResource FloatLabelScaled}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!--
        6.1 形态：无标题栏、无边框按钮、单行圆角长条。

        AllowsTransparency 自 M4.54 起必须是 **True** —— 这是跨进程鼠标穿透的前提。
        旧结论"必须保持 False"是基于"layered 会让 WPF 退掉硬件加速、毛玻璃变样"的顾虑，
        而实测（M4.54）：纯色/毛玻璃渲染、边距、圆角、文字色全都没变（sidecar 逐字段一致），
        换来的却是穿透真的能穿到游戏里。两者权衡后选 True。

        **不能运行时改**：WS_EX_LAYERED 由 WPF 自己管，窗口建好之后 SetWindowLongPtr 加这一位
        会在 WM_STYLECHANGING 阶段被抹掉（实测写入 0x801A8，返回时回读就是 0x1A8），
        所以只能在这里声明。

        **不能调 SetLayeredWindowAttributes**：那会把窗口切到"常量 alpha"模式，
        WPF 的逐像素位图随即被弃用 —— 实测悬浮窗变成一块纯灰空条，数字全没。
        见 Interop/PassThrough.cs。

        背景仍靠 WindowGlass 把 Window.Background 与 CompositionTarget.BackgroundColor
        一起刷透明来解决。

        底色的实际值由代码按「主题 × 浓度档」算出来（FloatWindow.ApplyGlass），
        XAML 这里只是打开瞬间的初值：浅色 16% 白。
        着色分两层：accent 的 tint（WindowGlass）+ 这里的 Shell 遮罩，
        两层相乘才是"遮住背景"的总量。浅色档系统自带约 85% 白底，所以浓度主要靠 Shell 拉。
    -->
    <Border x:Name="Shell" Height="{Binding ShellHeight, RelativeSource={RelativeSource AncestorType=Window}}"
            CornerRadius="10" BorderThickness="1"
            BorderBrush="{StaticResource BrushGlassEdge}" Background="{StaticResource BrushGlassTint}"
            Padding="10,0"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown"
            MouseRightButtonUp="Shell_MouseRightButtonUp"
            MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示大窗口" Click="ShowMain_Click" />

                <MenuItem x:Name="LockMenu" Header="锁定位置" IsCheckable="True"
                          Click="ToggleLock_Click"
                          ToolTip="锁定后拖动无效，防止误碰挪走（6.5）" />

                <!--
                    鼠标穿透（M4.21）。穿透后悬浮窗不接收任何鼠标消息（含右键），
                    所以出口必须另有其人：托盘图标右键菜单、设置页「悬浮窗交互」卡片、
                    全局热键切到大窗口。三者任一都能关掉它。
                -->
                <MenuItem x:Name="ThroughMenu" Header="鼠标穿透" IsCheckable="True"
                          Click="ToggleThrough_Click"
                          ToolTip="点悬浮窗等于点它下面的东西。开启后右键菜单失效，可从托盘图标或设置页关掉" />

                <MenuItem x:Name="TopmostMenu" Header="始终置顶" IsCheckable="True"
                          Click="ToggleTopmost_Click"
                          ToolTip="每秒把悬浮窗提回最顶层，压过游戏浮层等其它置顶窗口" />

                <Separator />

                <!--
                    排列（M4.10）：横向 = 6.1 的单行长条；竖向 = 同一组六项竖着摞起来。
                    竖向**不旋转文字**：字体一律保持水平正立，否则侧边条上的数字得歪头看。
                    与"缩放"一样是单选，互斥靠代码（WPF 菜单没有现成的 RadioMenuItem）。
                -->
                <MenuItem Header="排列">
                    <MenuItem x:Name="LayoutRowMenu" Header="横向" IsCheckable="True" IsChecked="True"
                              Click="Layout_Click" Tag="row"
                              ToolTip="单行长条（6.1 默认形态）" />
                    <MenuItem x:Name="LayoutColumnMenu" Header="竖向" IsCheckable="True"
                              Click="Layout_Click" Tag="column"
                              ToolTip="六项上下排列，文字保持横向正立，适合贴屏幕侧边" />
                </MenuItem>

                <!-- 单选靠代码互斥（WPF 菜单没有现成的 RadioMenuItem） -->
                <MenuItem Header="缩放">
                    <MenuItem x:Name="Scale100Menu" Header="100%" IsCheckable="True" IsChecked="True"
                              Click="Scale_Click" Tag="100" />
                    <MenuItem x:Name="Scale125Menu" Header="125%" IsCheckable="True" Click="Scale_Click" Tag="125" />
                    <MenuItem x:Name="Scale150Menu" Header="150%" IsCheckable="True" Click="Scale_Click" Tag="150" />
                </MenuItem>

                <MenuItem Header="外观">
                    <MenuItem x:Name="ThemeLightMenu" Header="浅色玻璃" IsCheckable="True" IsChecked="True"
                              Click="ThemeLight_Click" />
                    <MenuItem x:Name="ThemeDarkMenu" Header="深色玻璃" IsCheckable="True"
                              Click="ThemeDark_Click" />
                </MenuItem>

                <MenuItem Header="浓度">
                    <MenuItem x:Name="Level1Menu" Header="极透（无模糊）" IsCheckable="True" Click="Level_Click" Tag="1" />
                    <MenuItem x:Name="Level2Menu" Header="很透" IsCheckable="True" Click="Level_Click" Tag="2" />
                    <MenuItem x:Name="Level3Menu" Header="较透" IsCheckable="True" Click="Level_Click" Tag="3" />
                    <MenuItem x:Name="Level4Menu" Header="适中" IsCheckable="True" IsChecked="True"
                              Click="Level_Click" Tag="4" />
                    <MenuItem x:Name="Level5Menu" Header="较实" IsCheckable="True" Click="Level_Click" Tag="5" />
                    <MenuItem x:Name="Level6Menu" Header="很实" IsCheckable="True" Click="Level_Click" Tag="6" />
                    <MenuItem x:Name="Level7Menu" Header="极实" IsCheckable="True" Click="Level_Click" Tag="7" />
                </MenuItem>

                <MenuItem x:Name="GlassMenu" Header="毛玻璃" IsCheckable="True" IsChecked="True"
                          Click="ToggleGlass_Click" />

                <!--
                    显示字段（M4.14）：六项可独立开关。子项不写在 XAML 里 ——
                    按 FloatFields.Keys 在构造函数里生成，加字段时这里一行不用动，
                    也就不会出现"菜单顺序与表顺序错位"这种编译不报错的毛病。
                -->
                <!--
                    边框（M4.15）：静止时那圈描边要多亮。
                    「无」= 完全透明（悬停 / 拖动仍给反馈，否则窗口彻底没有边界感）；
                    「淡」= 5%；「明显」= 12%（深色玻璃上就是有人觉得"白"的那一档）。
                    深色桌面上「明显」那圈实测亮度 50、条内 16 —— 差 3 倍，看着就是一条白线。
                -->
                <MenuItem Header="边框">
                    <MenuItem x:Name="EdgeNoneMenu" Header="无" IsCheckable="True"
                              Click="Edge_Click" Tag="none"
                              ToolTip="静止时不描边；鼠标移上去或拖动时仍会显示" />
                    <MenuItem x:Name="EdgeFaintMenu" Header="淡" IsCheckable="True"
                              Click="Edge_Click" Tag="faint"
                              ToolTip="5% 浓度：能勾出四边，但不单独成线" />
                    <MenuItem x:Name="EdgeNormalMenu" Header="明显" IsCheckable="True" IsChecked="True"
                              Click="Edge_Click" Tag="normal"
                              ToolTip="12% 浓度：边界最清楚，深色桌面上会显出一圈白边" />
                </MenuItem>

                <MenuItem x:Name="FieldMenu" Header="显示字段"
                          ToolTip="关闭的字段不占位，条会跟着收缩；只剩一个时不可关闭" />
                <MenuItem Header="设置…" IsEnabled="False"
                          ToolTip="设置页在 M4 提供" />

                <Separator />
                <MenuItem Header="退出" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <!--
            两套面板并存，靠 Visibility 切换（同一时刻只有一套参与测量与渲染）。

            横向（6.1）：六格横排，每格"主值在上、次值在下"两行，列宽绑 FloatField.Width
                         （6.3 的 34/44/44/74/78/44），窗口 SizeToContent=Width。
                         **横向不拆分**（M4.11）：内存 / 显存仍是 `18.5/31.6G` 一行 ——
                         34 DIP 高的细条是 6.1 的形态本身，多一行就不是细条了。

            竖向（M4.10）：同一组六项沿竖直方向排成一条细高的条子，格内结构完全不变，
                         **文字一律水平正立**。
                         不旋转的理由：转过 90° 的字要歪头读，且 WPF 只对轴对齐的文字用
                         ClearType，旋转后必然退成灰度 AA 发虚。

                         M4.11 起"已用 / 总共"在竖向下拆成上下两行，条宽不再被
                         `18.5/31.6G` 撑着 —— 这句是之前把条撑到 61 DIP 的唯一原因，
                         拆完最长的一句变成 `31.6G`，条宽收到 47。
        -->
        <Grid>
            <StackPanel x:Name="RowPanel" Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel x:Name="RowFps" Width="{Binding FloatFps.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatFps.Top}"
                               Foreground="{Binding FloatFps.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatFps.Bottom}"
                               Foreground="{Binding FloatFps.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="RowCpu" Width="{Binding FloatCpu.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatCpu.Top}"
                               Foreground="{Binding FloatCpu.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatCpu.Bottom}"
                               Foreground="{Binding FloatCpu.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="RowGpu" Width="{Binding FloatGpu.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatGpu.Top}"
                               Foreground="{Binding FloatGpu.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatGpu.Bottom}"
                               Foreground="{Binding FloatGpu.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="RowRam" Width="{Binding FloatRam.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatRam.Top}"
                               Foreground="{Binding FloatRam.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatRam.Bottom}"
                               Foreground="{Binding FloatRam.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="RowVram" Width="{Binding FloatVram.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatVram.Top}"
                               Foreground="{Binding FloatVram.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatVram.Bottom}"
                               Foreground="{Binding FloatVram.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="RowNet" Width="{Binding FloatNet.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatNet.Top}"
                               Foreground="{Binding FloatNet.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatNet.Bottom}"
                               Foreground="{Binding FloatNet.SubBrush}" />
                </StackPanel>

                <!-- M4.18 补齐的三项（默认关闭，勾开才占位）。
                     尾部间距由 ApplyFieldVisibility 决定：只有"最后一个可见格"不给右间距，
                     否则关掉这三项时会多出一截空白，条子凭空变宽。 -->
                <StackPanel x:Name="RowDisk" Width="{Binding FloatDisk.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatDisk.Top}"
                               Foreground="{Binding FloatDisk.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatDisk.Bottom}"
                               Foreground="{Binding FloatDisk.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="RowIo" Width="{Binding FloatIo.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatIo.Top}"
                               Foreground="{Binding FloatIo.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatIo.Bottom}"
                               Foreground="{Binding FloatIo.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="RowPwr" Width="{Binding FloatPwr.Width}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FloatValueScaled}" Text="{Binding FloatPwr.Top}"
                               Foreground="{Binding FloatPwr.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelScaled}" Text="{Binding FloatPwr.Bottom}"
                               Foreground="{Binding FloatPwr.SubBrush}" />
                </StackPanel>

            </StackPanel>

            <!--
                竖向（M4.10 / M4.11）：整条变成细高的竖条，六项沿竖直方向排下去；
                每格仍是"主值在上、次值在下"，文字一律水平正立（不旋转，ClearType 也在）。
                内存 / 显存两格多一行：已用一行、总共一行（M4.11）。

                用 Grid 而不是 StackPanel：一列 Auto 宽，六个格子都被拉到同一宽度，
                左边界天然对齐，不会出现 "12%" 和 "31.6G" 各占一截、右侧参差的情况。
            -->
            <Grid x:Name="ColumnPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="ColFps" Grid.Row="0" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatFps.Top}"
                               Foreground="{Binding FloatFps.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatFps.Line2}"
                               Foreground="{Binding FloatFps.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatFps.Line3}"
                               Visibility="{Binding FloatFps.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatFps.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="ColCpu" Grid.Row="1" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatCpu.Top}"
                               Foreground="{Binding FloatCpu.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatCpu.Line2}"
                               Foreground="{Binding FloatCpu.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatCpu.Line3}"
                               Visibility="{Binding FloatCpu.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatCpu.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="ColGpu" Grid.Row="2" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatGpu.Top}"
                               Foreground="{Binding FloatGpu.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatGpu.Line2}"
                               Foreground="{Binding FloatGpu.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatGpu.Line3}"
                               Visibility="{Binding FloatGpu.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatGpu.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="ColRam" Grid.Row="3" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatRam.Top}"
                               Foreground="{Binding FloatRam.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatRam.Line2}"
                               Foreground="{Binding FloatRam.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatRam.Line3}"
                               Visibility="{Binding FloatRam.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatRam.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="ColVram" Grid.Row="4" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatVram.Top}"
                               Foreground="{Binding FloatVram.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatVram.Line2}"
                               Foreground="{Binding FloatVram.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatVram.Line3}"
                               Visibility="{Binding FloatVram.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatVram.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="ColNet" Grid.Row="5" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatNet.Top}"
                               Foreground="{Binding FloatNet.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatNet.Line2}"
                               Foreground="{Binding FloatNet.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatNet.Line3}"
                               Visibility="{Binding FloatNet.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatNet.SubBrush}" />
                </StackPanel>

                <!-- M4.18 补齐的三项，追加在末尾（老用户记的"第六个是网络延迟"不能挪） -->
                <StackPanel x:Name="ColDisk" Grid.Row="6" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatDisk.Top}"
                               Foreground="{Binding FloatDisk.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatDisk.Line2}"
                               Foreground="{Binding FloatDisk.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatDisk.Line3}"
                               Visibility="{Binding FloatDisk.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatDisk.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="ColIo" Grid.Row="7" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatIo.Top}"
                               Foreground="{Binding FloatIo.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatIo.Line2}"
                               Foreground="{Binding FloatIo.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatIo.Line3}"
                               Visibility="{Binding FloatIo.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatIo.SubBrush}" />
                </StackPanel>

                <StackPanel x:Name="ColPwr" Grid.Row="8" Margin="{Binding RowCellMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource FloatValueCentered}" Text="{Binding FloatPwr.Top}"
                               Foreground="{Binding FloatPwr.TopBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatPwr.Line2}"
                               Foreground="{Binding FloatPwr.SubBrush}" />
                    <TextBlock Style="{StaticResource FloatLabelCentered}" Text="{Binding FloatPwr.Line3}"
                               Visibility="{Binding FloatPwr.Line3Visibility}"
                               Margin="{Binding SplitGap, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding FloatPwr.SubBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
