<Window x:Class="CoPul.App.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoPul 芯脉 · 任务栏"
        Height="48" Width="404"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="False"
        Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        第 7 章 任务栏模式。

        与悬浮窗的关键差别：
        - 直角（7.3）：任务栏本身是直角，条再带圆角会显得"贴了张胶布"
        - 字号 11 / 9（7.3），比悬浮窗小一档
        - 背景默认完全透明（7.5「跟随系统」），只画字不画底，看起来就是任务栏自带的
        - 窗口是顶层 topmost 窗口（7.1 的 A 方案），贴在任务栏那一行上

        AllowsTransparency 仍然保持 False：开它会变 layered window，
        与 DWM 合成/硬件加速冲突（A-30）。透明靠 WindowGlass.MakeClientTransparent。

        各列的右侧间距由代码按"最后一个可见字段"决定（7.4 / Q-03：关闭字段后宽度收缩、
        不保留空位）。XAML 里的 Margin 只是首帧兜底，Reposition 会统一覆盖。
    -->
    <Window.Resources>
        <Style x:Key="TrayValue" TargetType="TextBlock" BasedOn="{StaticResource FloatValue}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
        </Style>

        <Style x:Key="TrayLabel" TargetType="TextBlock" BasedOn="{StaticResource FloatLabel}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="LineHeight" Value="12" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="#66000000" CornerRadius="6" Padding="6,0"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown"
            MouseRightButtonUp="Shell_MouseRightButtonUp">

        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened">
                <MenuItem Header="显示大窗口" Click="ShowMain_Click" />

                <Separator />

                <!-- 7.4 / Q-03：九字段独立开关。穿透开着时这条路径用不了，
                     同一份开关也在托盘右键菜单里（托盘是穿透模式下的唯一出口）。 -->
                <MenuItem x:Name="FieldMenu" Header="显示字段">
                    <MenuItem x:Name="FieldFpsMenu" Header="FPS" Tag="fps"
                              IsCheckable="True" Click="Field_Click" />
                    <MenuItem x:Name="FieldCpuMenu" Header="CPU" Tag="cpu"
                              IsCheckable="True" Click="Field_Click" />
                    <MenuItem x:Name="FieldGpuMenu" Header="GPU" Tag="gpu"
                              IsCheckable="True" Click="Field_Click" />
                    <MenuItem x:Name="FieldRamMenu" Header="内存" Tag="ram"
                              IsCheckable="True" Click="Field_Click" />
                    <MenuItem x:Name="FieldVramMenu" Header="显存" Tag="vram"
                              IsCheckable="True" Click="Field_Click" />
                    <MenuItem x:Name="FieldDiskMenu" Header="硬盘温度" Tag="disk"
                              IsCheckable="True" Click="Field_Click" />
                    <MenuItem x:Name="FieldIoMenu" Header="上传 / 下载" Tag="io"
                              IsCheckable="True" Click="Field_Click" />
                    <MenuItem x:Name="FieldLatMenu" Header="网络延迟" Tag="lat"
                              IsCheckable="True" Click="Field_Click" />
                    <MenuItem x:Name="FieldPwrMenu" Header="整机功耗" Tag="pwr"
                              IsCheckable="True" Click="Field_Click" />
                </MenuItem>

                <MenuItem Header="文字颜色">
                    <MenuItem x:Name="AutoInkMenu" Header="跟随系统" IsCheckable="True" IsChecked="True"
                              Click="InkAuto_Click" />
                    <MenuItem x:Name="LightInkMenu" Header="浅色字（深底）" IsCheckable="True"
                              Click="InkLight_Click" />
                    <MenuItem x:Name="DarkInkMenu" Header="深色字（浅底）" IsCheckable="True"
                              Click="InkDark_Click" />
                </MenuItem>

                <Separator />

                <MenuItem Header="切到悬浮窗" Click="ToFloat_Click" />
                <MenuItem Header="退出" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <!-- 列宽与间距按 7.3 / 7.4：值行 11 DIP、标签行 9 DIP，组间距 7 DIP -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <StackPanel x:Name="FpsCell" Width="{Binding FloatFps.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatFps.Top}"
                           Foreground="{Binding FloatFps.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatFps.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel x:Name="CpuCell" Width="{Binding FloatCpu.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatCpu.Top}"
                           Foreground="{Binding FloatCpu.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatCpu.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel x:Name="GpuCell" Width="{Binding FloatGpu.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatGpu.Top}"
                           Foreground="{Binding FloatGpu.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatGpu.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel x:Name="RamCell" Width="{Binding FloatRam.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatRam.Top}"
                           Foreground="{Binding FloatRam.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatRam.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <!-- 显存：紧跟在内存后面，方便一眼对比"内存 / 显存"两条占用。
                 两行都带小写 v（6.3 / Q-04），条上字号再小也不会跟内存混。 -->
            <StackPanel x:Name="VramCell" Width="{Binding FloatVram.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatVram.Top}"
                           Foreground="{Binding FloatVram.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatVram.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <!-- 硬盘温度：7.4 要求上下排列（上行盘 1、下行盘 2） -->
            <StackPanel x:Name="DiskCell" Width="{Binding FloatDisk.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatDisk.Top}"
                           Foreground="{Binding FloatDisk.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatDisk.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <!-- 上下行：↑ 上、↓ 下 -->
            <StackPanel x:Name="IoCell" Width="{Binding FloatIo.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatIo.Top}"
                           Foreground="{Binding FloatIo.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatIo.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel x:Name="LatCell" Width="{Binding FloatLat.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatLat.Top}"
                           Foreground="{Binding FloatLat.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatLat.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel x:Name="PwrCell" Width="{Binding FloatPwr.Width}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatPwr.Top}"
                           Foreground="{Binding FloatPwr.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatPwr.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
