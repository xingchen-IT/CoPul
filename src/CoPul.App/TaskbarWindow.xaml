<Window x:Class="CoPul.App.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoPul 芯脉 · 任务栏"
        Height="48" Width="404"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="False"
        Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        第 7 章 任务栏模式。

        与悬浮窗的关键差别：
        - 直角（7.3）：任务栏本身是直角，条再带圆角会显得"贴了张胶布"
        - 字号 11 / 9（7.3），比悬浮窗小一档
        - 背景默认完全透明（7.5「跟随系统」），只画字不画底，看起来就是任务栏自带的
        - 窗口是 Shell_TrayWnd 的子窗口，不是顶层窗口，所以不能设 Topmost

        AllowsTransparency 仍然保持 False：开它会变 layered window，
        与 DWM 合成/硬件加速冲突（A-30）。透明靠 WindowGlass.MakeClientTransparent。
    -->
    <Window.Resources>
        <Style x:Key="TrayValue" TargetType="TextBlock" BasedOn="{StaticResource FloatValue}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
        </Style>

        <Style x:Key="TrayLabel" TargetType="TextBlock" BasedOn="{StaticResource FloatLabel}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="LineHeight" Value="12" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="#66000000" CornerRadius="6" Padding="6,0"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown"
            MouseRightButtonUp="Shell_MouseRightButtonUp">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示大窗口" Click="ShowMain_Click" />

                <Separator />

                <MenuItem Header="文字颜色">
                    <MenuItem x:Name="AutoInkMenu" Header="跟随系统" IsCheckable="True" IsChecked="True"
                              Click="InkAuto_Click" />
                    <MenuItem x:Name="LightInkMenu" Header="浅色字（深底）" IsCheckable="True"
                              Click="InkLight_Click" />
                    <MenuItem x:Name="DarkInkMenu" Header="深色字（浅底）" IsCheckable="True"
                              Click="InkDark_Click" />
                </MenuItem>

                <Separator />

                <MenuItem Header="切到悬浮窗" Click="ToFloat_Click" />
                <MenuItem Header="退出" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <!-- 列宽与间距按 7.3 / 7.4：值行 11 DIP、标签行 9 DIP，组间距 8 DIP -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <StackPanel Width="{Binding FloatFps.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatFps.Top}"
                           Foreground="{Binding FloatFps.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatFps.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatCpu.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatCpu.Top}"
                           Foreground="{Binding FloatCpu.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatCpu.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatGpu.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatGpu.Top}"
                           Foreground="{Binding FloatGpu.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatGpu.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatRam.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatRam.Top}"
                           Foreground="{Binding FloatRam.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatRam.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <!-- 硬盘温度：7.4 要求上下排列（上行盘 1、下行盘 2） -->
            <StackPanel Width="{Binding FloatDisk.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatDisk.Top}"
                           Foreground="{Binding FloatDisk.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatDisk.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <!-- 上下行：↑ 上、↓ 下 -->
            <StackPanel Width="{Binding FloatIo.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatIo.Top}"
                           Foreground="{Binding FloatIo.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatIo.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatLat.Width}" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatLat.Top}"
                           Foreground="{Binding FloatLat.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatLat.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Width="{Binding FloatPwr.Width}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TrayValue}" Text="{Binding FloatPwr.Top}"
                           Foreground="{Binding FloatPwr.TopBrushAlt}" />
                <TextBlock Style="{StaticResource TrayLabel}" Text="{Binding FloatPwr.Bottom}"
                           Foreground="{Binding LabelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
