<Window x:Class="CoPul.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CoPul.App.Controls"
        Title="CoPul 芯脉" Width="820" Height="1460" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBg}" FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：标题栏整块都是客户区，按钮才可点；拖动由代码里的 DragMove 负责 -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushStroke}" BorderThickness="1" Background="{StaticResource BrushBg}"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="CoPul" Style="{StaticResource TextBrand}" />
                    <TextBlock Text="芯脉 · 实时资源监控" Style="{StaticResource TextBrandSub}" />

                    <!--
                        运行状态灯。两层圆：外圈 10px 同色 22% 透明度当光晕（不闪、不动，
                        10.3 禁霓虹感），内芯 6px 实色。
                        ToolTip 绑 StatusText——降级原因可能一长串，塞进标题栏会挤掉品牌名，
                        悬停看详情是这里唯一不牺牲布局的做法。
                    -->
                    <Grid Width="10" Height="10" Margin="14,0,0,0" VerticalAlignment="Center"
                          ToolTip="{Binding StatusText}">
                        <Ellipse Fill="{Binding RunStateBrush}" Opacity="0.22" />
                        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{Binding RunStateBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding RunStateText}" Style="{StaticResource TextRunState}"
                               Foreground="{Binding RunStateBrush}" Margin="7,0,0,0"
                               ToolTip="{Binding StatusText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource TitleBarButton}" Content="⚙"
                            ToolTip="设置（M2 实现）" Click="Settings_Click" />
                    <Button Style="{StaticResource TitleBarButton}" Content="—"
                            ToolTip="最小化" Click="Minimize_Click" />
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="✕"
                            ToolTip="退出" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,4,12,12">
                <StackPanel>

                    <!-- CPU 区块 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="cpu"
                                            Content="{Binding CpuBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="CPU" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentCpu}" />
                                    <TextBlock Text="{Binding CpuModel}" Style="{StaticResource TextBlockModel}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource TextBody}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding LoadAvgText, StringFormat='负载均值 1/5/15  {0}'}" />
                            </Grid>

                            <StackPanel Visibility="{Binding CpuBlock.BodyVisibility}">
                                <UniformGrid Columns="4" Margin="0,12,0,0">
                                    <controls:MetricTile DataContext="{Binding CpuLoad}" />
                                    <controls:MetricTile DataContext="{Binding CpuTemp}" />
                                    <controls:MetricTile DataContext="{Binding CpuClock}" />
                                    <controls:MetricTile DataContext="{Binding CpuPower}" />
                                </UniformGrid>

                                <TextBlock Text="{Binding CoresText}" Style="{StaticResource TextMono}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- GPU 区块 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="gpu"
                                            Content="{Binding GpuBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="GPU" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentGpu}" />
                                    <TextBlock Text="{Binding GpuModel}" Style="{StaticResource TextBlockModel}" />
                                </StackPanel>
                                <TextBlock Text="{Binding GpuExtraText}" Style="{StaticResource TextBody}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!--
                              6 列网格装 5 格：首行 3 个各占 2 列，次行 2 个各占 3 列，两行都填满、不留缺口。
                              原第 6 格「风扇」已移除：移动版 NVML 不提供 fan tach（nvidia-smi 同样返回 N/A），
                              与 CPU 风扇（无 SuperIO）一样属于硬件不提供，留着只会永远显示占位符，见 R26。
                            -->
                            <Grid Margin="0,12,0,0" Visibility="{Binding GpuBlock.BodyVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:MetricTile Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                     Margin="0,0,12,12" DataContext="{Binding GpuLoad}" />
                                <controls:MetricTile Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                                     Margin="0,0,12,12" DataContext="{Binding GpuTemp}" />
                                <controls:MetricTile Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                                                     Margin="0,0,0,12" DataContext="{Binding GpuPower}" />
                                <controls:MetricTile Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                     Margin="0,0,12,0" DataContext="{Binding GpuMem}" />
                                <controls:MetricTile Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                                                     Margin="0,0,0,0" DataContext="{Binding GpuClock}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--
                        FPS 区块（M1.5）：一排六格（帧率 / 最低 / 最高 / 平均 / 1% Low / 帧时间）
                        + 折线。统计三格为近 60 秒窗口，紧跟帧率是因为同属"帧率"这一个量。
                        数据源只能是 PresentMon 的 ETW 呈现流 —— Windows 没有任何 API
                        直接给帧率（需求 4.6 / Q-07）。本版采集未接入，六格恒为 `—`，
                        折线区只有网格：不写 0（A-13），也不在这里塞演示曲线。
                        副标题已写明原因，接通后改成「前台进程帧率 · 近 60 秒 · 0–240 FPS」。
                    -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="fps"
                                            Content="{Binding FpsBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="FPS" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentFps}" />
                                    <TextBlock Text="{Binding FpsSubtitle}" Style="{StaticResource TextBlockModel}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding FpsBlock.BodyVisibility}">
                                <!-- 一排六格：帧率 → 最低 / 最高 / 平均（近 60 秒窗口统计）
                                     → 1% Low → 帧时间。
                                     统计三件套紧跟帧率，因为它们是同一个量的不同口径；
                                     1% Low 与帧时间属于"另一类"（流畅度 / 单帧耗时），排在后面。 -->
                                <UniformGrid Columns="6" Margin="0,12,0,0">
                                    <controls:MetricTile DataContext="{Binding FpsValue}" />
                                    <controls:MetricTile DataContext="{Binding FpsMin}" />
                                    <controls:MetricTile DataContext="{Binding FpsMax}" />
                                    <controls:MetricTile DataContext="{Binding FpsAvg}" />
                                    <controls:MetricTile DataContext="{Binding FpsLow1}" />
                                    <controls:MetricTile DataContext="{Binding FpsTime}" />
                                </UniformGrid>

                                <!-- 量程 240：覆盖 60/120/144/165/240 Hz 全部常见刷新率。
                                     再高的帧率会平顶，好过让 240 以下的分辨率被压扁。 -->
                                <controls:TrendChart x:Name="FpsView" Height="104" Margin="0,10,0,0"
                                                     MaxValue="240" Unit="FPS"
                                                     Visibility="{Binding FpsBlock.BodyVisibility}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        趋势区块（M1.4）：CPU / GPU 使用率折线。
                        纵轴固定 0–100%，不做自动缩放 —— 占用率本来就有上界，
                        自动缩放会把 5% 的抖动画成满载。
                    -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="trend"
                                            Content="{Binding TrendBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="趋势" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentCpu}" />
                                    <TextBlock Text="{Binding TrendSubtitle}" Style="{StaticResource TextBlockModel}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="CPU" Style="{StaticResource TextBody}"
                                               Foreground="{StaticResource AccentCpu}" Margin="0,0,12,0" />
                                    <TextBlock Text="GPU" Style="{StaticResource TextBody}"
                                               Foreground="{StaticResource AccentGpu}" />
                                </StackPanel>
                            </Grid>

                            <controls:TrendChart x:Name="TrendView" Height="104" Margin="0,10,0,0"
                                                 Visibility="{Binding TrendBlock.BodyVisibility}" />
                        </StackPanel>
                    </Border>

                    <!--
                        温度区块（M1.4b）：CPU / GPU 温度折线，与占用率分开一张图。
                        量程同样固定 0–100°C —— 温度是慢变量，自动缩放会让它每次改纵轴，
                        反而看不出"温度是不是在往上涨"。
                    -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="temp"
                                            Content="{Binding TempBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="温度" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentPower}" />
                                    <TextBlock Text="{Binding TempSubtitle}" Style="{StaticResource TextBlockModel}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="CPU" Style="{StaticResource TextBody}"
                                               Foreground="{StaticResource AccentCpu}" Margin="0,0,12,0" />
                                    <TextBlock Text="GPU" Style="{StaticResource TextBody}"
                                               Foreground="{StaticResource AccentGpu}" />
                                </StackPanel>
                            </Grid>

                            <controls:TrendChart x:Name="TempView" Height="104" Margin="0,10,0,0"
                                                 MaxValue="100" Unit="°C"
                                                 Visibility="{Binding TempBlock.BodyVisibility}" />
                        </StackPanel>
                    </Border>

                    <!-- 内存区块 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="mem"
                                            Content="{Binding MemBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="内存" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentRam}" />
                                    <TextBlock Text="{Binding MemHeadline}" Style="{StaticResource TextBlockModel}" />
                                </StackPanel>
                                <TextBlock Text="{Binding MemDetail}" Style="{StaticResource TextBody}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,12,0,0"
                                         Visibility="{Binding MemBlock.BodyVisibility}">
                                <controls:MetricTile DataContext="{Binding MemLoad}" />
                                <controls:MetricTile DataContext="{Binding MemUsed}" />
                                <controls:MetricTile DataContext="{Binding MemCommit}" />
                                <controls:MetricTile DataContext="{Binding MemCached}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 网络区块 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="net"
                                            Content="{Binding NetBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="网络" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentNet}" />
                                    <TextBlock Text="{Binding NetAdapter}" Style="{StaticResource TextBlockModel}" />
                                </StackPanel>
                                <TextBlock Text="{Binding NetTargetText}" Style="{StaticResource TextBody}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,12,0,0"
                                         Visibility="{Binding NetBlock.BodyVisibility}">
                                <controls:MetricTile DataContext="{Binding NetDown}" />
                                <controls:MetricTile DataContext="{Binding NetUp}" />
                                <controls:MetricTile DataContext="{Binding NetLatency}" />
                                <controls:MetricTile DataContext="{Binding NetLoss}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 硬盘区块 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="disk"
                                            Content="{Binding DiskBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="硬盘" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentDisk}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DiskSummary}" Style="{StaticResource TextBody}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Visibility="{Binding DiskBlock.BodyVisibility}">
                                <!-- 表头：单盘读写是新加的列（D03 每盘），没有表头会读不懂 -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="型号" Style="{StaticResource TextLabel}" />
                                    <TextBlock Grid.Column="1" Text="总线" Style="{StaticResource TextLabel}" />
                                    <TextBlock Grid.Column="2" Text="容量" Style="{StaticResource TextLabel}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="读 MB/s" Style="{StaticResource TextLabel}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="写 MB/s" Style="{StaticResource TextLabel}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="温度" Style="{StaticResource TextLabel}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Background="{StaticResource BrushTrack}" Height="1" Margin="0,4,0,0" />

                                <ItemsControl ItemsSource="{Binding Disks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Model}"
                                                           Style="{StaticResource TextBody}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Bus}"
                                                           Style="{StaticResource TextBody}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CapacityText}"
                                                           Style="{StaticResource TextBody}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding ReadText}"
                                                           Style="{StaticResource TextMonoRow}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{Binding WriteText}"
                                                           Style="{StaticResource TextMonoRow}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="{Binding Temp}"
                                                           Style="{StaticResource TextBody}" HorizontalAlignment="Right"
                                                           Foreground="{Binding TempBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{StaticResource BrushTrack}" Height="1" Margin="0,10,0,8" />

                                <TextBlock Text="{Binding PartitionText}" Style="{StaticResource TextBody}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        进程区块（M1.4）：占用最高的 8 个进程，5 秒刷新。
                        排序取 CPU 与 GPU 的较大者 —— 只按 CPU 排的话，
                        正在硬解码 / 跑游戏但主逻辑很闲的进程永远排不上来。
                    -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FoldButton}" Tag="proc"
                                            Content="{Binding ProcBlock.Arrow}" Click="ToggleBlock_Click"
                                            ToolTip="折叠 / 展开" />
                                    <TextBlock Text="进程" Style="{StaticResource TextBlockTitle}"
                                               Foreground="{StaticResource AccentFps}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProcSubtitle}" Style="{StaticResource TextBody}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Visibility="{Binding ProcBlock.BodyVisibility}">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="进程" Style="{StaticResource TextLabel}" />
                                    <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource TextLabel}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="CPU %" Style="{StaticResource TextLabel}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="GPU %" Style="{StaticResource TextLabel}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="内存" Style="{StaticResource TextLabel}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Background="{StaticResource BrushTrack}" Height="1" Margin="0,4,0,0" />

                                <ItemsControl ItemsSource="{Binding Processes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Style="{StaticResource TextBody}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding PidText}"
                                                           Style="{StaticResource TextBody}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource BrushTextTertiary}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CpuText}"
                                                           Style="{StaticResource TextMonoRow}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{Binding CpuBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding GpuText}"
                                                           Style="{StaticResource TextMonoRow}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{Binding MemText}"
                                                           Style="{StaticResource TextMonoRow}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 状态与诊断 -->
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextBody}"
                               Foreground="{Binding StatusBrush}" Margin="4,2,4,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
