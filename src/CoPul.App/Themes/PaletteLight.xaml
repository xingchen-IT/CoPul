<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        ===================================================================
        白色主题（App 级：大窗口 + 设置页）—— 默认主题。
        ===================================================================

        键名与 PaletteDark.xaml **完全同名**，运行时整本替换。改颜色必须两边一起改。

        设计取向与深色不同，不是简单反色：

        1. **卡片靠描边 + 底色差分层，不加投影。** 深色靠"窗口底压深 + 卡片提亮"11 个色阶分层
           （#0B0E13 对 #161D26）。白色底 #F2F4F7 对卡片 #FFFFFF 只差 6 个色阶，单靠这点差异
           边界偏弱，所以描边取 #DDE3EA（比深色主题的 #232C36 更明确地"收住"每张卡），
           再配合 12 DIP 的卡片间距，九张卡是分得开的。
           **不引入 DropShadowEffect**：用户明确要求白色界面无阴影；而且投影会塞满
           12 DIP 的卡片缝（实测缝内像素被压到 113,114,115），白界面反而显脏。

        2. **文字对比度按 4.5:1 起步。** 白底比深底"宽容"，但也更容易糊：
           深色下 #9AA4B2 对 #161D26 有 7.4:1，同样一个灰放到白底只剩 2.3:1，必须压深。

        3. **语义色直接复用悬浮窗浅色玻璃那套值**（PaletteShared 的 *Light）。
           那套是为了"白雾玻璃底"调的，实测 ≥4.5:1；白色纸面比白雾更亮，只会更清楚。
           复用而不是另造：两个界面语义色一致，也避免白纸上出现两套"同一个蓝"。

        4. **绿色要单独压暗。** #63A96D 在白底只有 2.9:1，10px 的状态灯会看不清；
           压到 #3F8A4C 保住语义同时够对比度。
        ===================================================================
    -->

    <!-- 标记键：ThemeManager 靠它定位"哪一本是主题字典"。不是给 XAML 用的。 -->
    <sys:String x:Key="__theme">light</sys:String>

    <!--
        结构层。

        层级安排：窗口底 #F2F4F7（微冷灰，比纯白耐看且不刺眼）→ 卡片 #FFFFFF（纯白，最亮）
        → 悬停 #F7F9FB（比卡片略暗一点点，暗示"这块可以点"）。
        注意悬停比卡片**暗**而不是亮 —— 白底上"更亮"意味着趋近纯白，会被误认为"选中"。
    -->
    <!--
        窗口底 #F2F4F7 → #EDF0F4（2026-11-01，去掉投影之后重新配）。

        原来的 #F2F4F7 与卡片 #FFFFFF 只差 13/11/8 个色阶，而卡片描边是 #DDE3EA 已经很淡，
        实测九张卡连成一片、"像一张大白纸上画了几条线"。既然用户不要阴影，
        就只能靠**底色差**分层 —— 把窗口底再压深 5 个色阶，卡片立刻浮起来，
        而且比投影干净（不会在卡片缝里塞灰）。
    -->
    <SolidColorBrush x:Key="BrushBg"           Color="#EDF0F4" />
    <SolidColorBrush x:Key="BrushPanel"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushPanelHover"   Color="#F7F9FB" />
    <SolidColorBrush x:Key="BrushStroke"       Color="#DDE3EA" />
    <SolidColorBrush x:Key="BrushTrack"        Color="#E4E9EF" />

    <!-- 分隔线：比描边更淡，否则表格里全是框 -->
    <SolidColorBrush x:Key="BrushDivider"      Color="#E8EDF2" />
    <!-- 图表网格线：白底上要"几乎看不见"，只暗示量程。比分隔线再淡一档 -->
    <SolidColorBrush x:Key="BrushGrid"         Color="#EFF2F6" />

    <!-- 表格隔行底：纯白卡片上的一层极淡灰，间隔感靠它而不是靠加粗分隔线 -->
    <SolidColorBrush x:Key="BrushRowAlt"       Color="#FAFBFC" />

    <!-- 滚动条滑块：白底上要"压深"才看得见，与深色主题正好相反。
         三档仍是低饱和中性灰偏冷（#B8C0CB 系），与 10.3「禁止霓虹色」一致。 -->
    <SolidColorBrush x:Key="BrushScrollThumb"      Color="#B8C0CB" />
    <SolidColorBrush x:Key="BrushScrollThumbHover" Color="#A6AFBC" />
    <SolidColorBrush x:Key="BrushScrollThumbDrag"  Color="#94A0AE" />

    <!-- 文字（对比度按第 2 条：主 15.8:1 / 次 6.4:1 / 三级 3.1:1）
         三级只用于"辅助说明、不承载数值"，所以允许略低于 4.5:1。 -->
    <SolidColorBrush x:Key="BrushTextPrimary"   Color="#1A1D22" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#5D6672" />
    <SolidColorBrush x:Key="BrushTextTertiary"  Color="#8A929C" />

    <!-- 语义色：与 PaletteShared 的 *Light 完全同值（第 3 条）。
         写死在这里而不是 DynamicResource 指向 *Light 键 ——
         主题字典必须能独立整本替换，跨字典引用会在"Shared 未加载"时断链。 -->
    <SolidColorBrush x:Key="AccentCpu"   Color="#2F62C4" />
    <SolidColorBrush x:Key="AccentGpu"   Color="#197A6E" />
    <SolidColorBrush x:Key="AccentRam"   Color="#6350C8" />
    <SolidColorBrush x:Key="AccentVram"  Color="#7B4FB5" />
    <SolidColorBrush x:Key="AccentNet"   Color="#96601A" />
    <SolidColorBrush x:Key="AccentFps"   Color="#3F7A3B" />
    <SolidColorBrush x:Key="AccentDisk"  Color="#55636F" />
    <SolidColorBrush x:Key="AccentPower" Color="#A24A26" />

    <!-- 阈值色（覆盖语义色，优先级最高）：白底版比深色版再压一档，保证"黄/红"仍然醒目 -->
    <SolidColorBrush x:Key="BrushWarn"   Color="#96601A" />
    <SolidColorBrush x:Key="BrushDanger" Color="#B83232" />

    <!-- 运行状态绿：单独压暗（第 4 条），白底上 4.6:1 -->
    <SolidColorBrush x:Key="BrushOk"     Color="#3F8A4C" />

</ResourceDictionary>
