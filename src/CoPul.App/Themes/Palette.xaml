<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        配色来自需求 10.3「低饱和、工业感，禁止霓虹色」。
        大窗口（9 区块）走深色一档；浅色只用于 M2 悬浮窗的「浅色毛玻璃」，
        因此浅色语义色统一用 `Light` 后缀命名，不与深色那组混用。
        所有画刷都 Freeze 过，避免每帧刷新时产生额外开销。
    -->

    <!-- 背景与结构 -->
    <SolidColorBrush x:Key="BrushBg"           Color="#0F1216" />
    <SolidColorBrush x:Key="BrushPanel"        Color="#151B21" />
    <SolidColorBrush x:Key="BrushPanelHover"   Color="#1B222A" />
    <SolidColorBrush x:Key="BrushStroke"       Color="#242C35" />
    <SolidColorBrush x:Key="BrushTrack"        Color="#232B33" />

    <!-- 滚动条滑块：常态只比轨道亮一档（不抢视线），悬停/拖动才提对比。
         三档都是低饱和中性灰，与 10.3「禁止霓虹色」一致。 -->
    <SolidColorBrush x:Key="BrushScrollThumb"      Color="#39434F" />
    <SolidColorBrush x:Key="BrushScrollThumbHover" Color="#4C5764" />
    <SolidColorBrush x:Key="BrushScrollThumbDrag"  Color="#5E6A79" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="BrushTextPrimary"   Color="#E8ECF2" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#9AA4B2" />
    <SolidColorBrush x:Key="BrushTextTertiary"  Color="#6B7480" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="AccentCpu"   Color="#5B8FF9" />
    <SolidColorBrush x:Key="AccentGpu"   Color="#4FB3A6" />
    <SolidColorBrush x:Key="AccentRam"   Color="#9B8AFB" />
    <SolidColorBrush x:Key="AccentVram"  Color="#B98FE8" />
    <SolidColorBrush x:Key="AccentNet"   Color="#E0A44A" />
    <SolidColorBrush x:Key="AccentFps"   Color="#7FB37A" />
    <SolidColorBrush x:Key="AccentDisk"  Color="#8C9BAA" />
    <SolidColorBrush x:Key="AccentPower" Color="#D97E5A" />

    <!-- 阈值色（覆盖语义色，优先级最高） -->
    <SolidColorBrush x:Key="BrushWarn"   Color="#E0A44A" />
    <SolidColorBrush x:Key="BrushDanger" Color="#D95C5C" />

    <!-- 运行状态（顶部指示灯）。绿色只给「一切正常」，降级仍用 BrushWarn，
         避免出现「黄灯也好看」的错觉：10.3 要求低饱和，这里不用霓虹绿。 -->
    <SolidColorBrush x:Key="BrushOk"     Color="#63A96D" />

    <!-- ===================================================================
         浅色毛玻璃（悬浮窗专用）
         白雾底 + 深色文字。要点是语义色必须"压暗"一档：深色档的 #5B8FF9 叠在
         白雾上对比度只有约 2.6:1，#E0A44A 更是只有 1.9:1，13px 粗体也会发虚。
         这里保持色相不变、只降明度，色相辨识度还在，可读性拉到 4.5:1 以上。

         边框用淡黑而不是白：白描边在奶白玻璃上等于看不见，
         而玻璃质感需要一条能"收住边缘"的线。
         =================================================================== -->

    <!-- 玻璃本体 -->
    <SolidColorBrush x:Key="BrushGlassTint"       Color="#29FFFFFF" />  <!-- 白 16%，叠在 accent tint 上 -->
    <SolidColorBrush x:Key="BrushGlassSolid"      Color="#F2F4F7" />    <!-- 关掉毛玻璃时的不透明底（浅） -->
    <SolidColorBrush x:Key="BrushGlassEdge"       Color="#1F000000" />  <!-- 黑 12% -->
    <SolidColorBrush x:Key="BrushGlassEdgeHover"  Color="#3D000000" />  <!-- 黑 24% -->

    <!-- 深色玻璃的描边：奶白底上用黑、深色底上用白，各取"能在自己底上看见"的那一头。
         hover 那一档从 22% 收到 14%（M4.13）：深色玻璃底本来只有 25 luma，
         22% 白一叠就是一圈明显的白线，鼠标一碰、一拖就整圈亮；
         14% 仍然看得出"这块可以点"，但不至于像给条子镶了银边。 -->
    <SolidColorBrush x:Key="BrushGlassEdgeDark"       Color="#1FFFFFFF" />  <!-- 白 12% -->
    <SolidColorBrush x:Key="BrushGlassEdgeDarkHover"  Color="#24FFFFFF" />  <!-- 白 14% -->

    <!--
        拖动中的描边（M4.14）：粉色。

        为什么单开一个颜色而不是继续用"提亮一档"：按住拖动时窗口一直在动，
        整圈提亮只表达"我被抓住了"，看起来像镶了一条白边（用户原话"不好看"）。
        粉色是**只在拖动期间出现**的状态色，手一松就消失，语义清楚：
        "现在这东西跟着你的手走"。深浅两版都取不透明粉 —— 半透明的粉在深色玻璃上
        会灰掉、在浅色玻璃上会洗白，两头都不像粉。
    -->
    <SolidColorBrush x:Key="BrushGlassEdgeDrag"      Color="#E8489B" />  <!-- 浅色底：稍沉的粉 -->
    <SolidColorBrush x:Key="BrushGlassEdgeDragDark"  Color="#FF7FB8" />  <!-- 深色底：提亮的粉 -->

    <!-- 文字 -->
    <SolidColorBrush x:Key="BrushTextOnGlass"          Color="#1B2027" />
    <SolidColorBrush x:Key="BrushTextSecondaryLight"   Color="#5C6672" />

    <!-- 语义色（浅底版） -->
    <SolidColorBrush x:Key="AccentCpuLight"   Color="#2F62C4" />
    <SolidColorBrush x:Key="AccentGpuLight"   Color="#197A6E" />
    <SolidColorBrush x:Key="AccentRamLight"   Color="#6350C8" />
    <SolidColorBrush x:Key="AccentVramLight"  Color="#7B4FB5" />
    <SolidColorBrush x:Key="AccentNetLight"   Color="#96601A" />
    <SolidColorBrush x:Key="AccentFpsLight"   Color="#3F7A3B" />
    <SolidColorBrush x:Key="AccentDiskLight"  Color="#55636F" />
    <SolidColorBrush x:Key="AccentPowerLight" Color="#A24A26" />

    <!-- 阈值色（浅底版）：仍压过语义色 -->
    <SolidColorBrush x:Key="BrushWarnLight"   Color="#96601A" />
    <SolidColorBrush x:Key="BrushDangerLight" Color="#B83232" />

</ResourceDictionary>
