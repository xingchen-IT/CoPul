<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        R-04 指标图标组 + R-05 状态图标组（M4.9）。

        为什么是 Geometry 资源而不是 .svg/.png 素材：
        R-04 要求「单色，仅描边不填充；必须与文字色同步」。位图做不到随主题换色，
        做多套位图只会让主题维护量翻倍；而 WPF 的 Path 直接吃 Stroke 绑定，
        一块几何资源就能被 CPU/GPU/内存三处分别染成各自的语义色。
        几何按 10.5 的规格画在 24×24 画布、1.5 描边、圆角线帽，显示时缩到 16 DIP
        （24→16 是 2/3，1.5 描边落到 1.0 DIP，150% 缩放下是 1.5 物理像素，正好像素对齐）。

        坐标一律落在 0.5 / 0.1 的整数倍上，避免缩放到 100% 缩放时出现半像素发虚。
    -->

    <!-- ============ R-04：区块标题图标 ============ -->

    <!-- CPU：芯片（外框 + 内核 + 八根引脚） -->
    <Geometry x:Key="IconCpu">
        M6.9,4.5 H17.1 A2.4,2.4 0 0 1 19.5,6.9 V17.1 A2.4,2.4 0 0 1 17.1,19.5 H6.9
        A2.4,2.4 0 0 1 4.5,17.1 V6.9 A2.4,2.4 0 0 1 6.9,4.5 Z
        M9.6,9.6 H14.4 V14.4 H9.6 Z
        M9,4.5 V2.4 M15,4.5 V2.4 M9,19.5 V21.6 M15,19.5 V21.6
        M4.5,9 H2.4 M4.5,15 H2.4 M19.5,9 H21.6 M19.5,15 H21.6
    </Geometry>

    <!-- GPU：显卡（卡体 + 双风扇） -->
    <Geometry x:Key="IconGpu">
        M4.8,6 H19.2 A2.4,2.4 0 0 1 21.6,8.4 V15.6 A2.4,2.4 0 0 1 19.2,18 H4.8
        A2.4,2.4 0 0 1 2.4,15.6 V8.4 A2.4,2.4 0 0 1 4.8,6 Z
        M5.4,12 A2.6,2.6 0 1 0 10.6,12 A2.6,2.6 0 1 0 5.4,12 Z
        M13.4,12 A2.6,2.6 0 1 0 18.6,12 A2.6,2.6 0 1 0 13.4,12 Z
    </Geometry>

    <!-- FPS：画框 + 播放三角 -->
    <Geometry x:Key="IconFps">
        M4.8,4.5 H19.2 A2.4,2.4 0 0 1 21.6,6.9 V17.1 A2.4,2.4 0 0 1 19.2,19.5 H4.8
        A2.4,2.4 0 0 1 2.4,17.1 V6.9 A2.4,2.4 0 0 1 4.8,4.5 Z
        M10,8.9 L15.8,12 L10,15.1 Z
    </Geometry>

    <!-- 趋势：折线（R-04 未列，趋势区块是 M1.4 新增的，补一枚同类风格） -->
    <Geometry x:Key="IconTrend">
        M2.7,18.9 L8.4,11.4 L12.9,15 L21.3,5.4
    </Geometry>

    <!-- 温度：温度计（管 + 球 + 两道刻度） -->
    <Geometry x:Key="IconTemp">
        M10,15.6 V6.6 A2,2 0 0 1 14,6.6 V15.6
        M8.7,18.2 A3.3,3.3 0 1 0 15.3,18.2 A3.3,3.3 0 1 0 8.7,18.2 Z
        M15.9,8.4 H18.9 M15.9,12.4 H18.9
    </Geometry>

    <!-- RAM：内存条（条体 + 五根金手指） -->
    <Geometry x:Key="IconRam">
        M3.9,6.9 H20.1 A2.1,2.1 0 0 1 22.2,9 V14.4 A2.1,2.1 0 0 1 20.1,16.5 H3.9
        A2.1,2.1 0 0 1 1.8,14.4 V9 A2.1,2.1 0 0 1 3.9,6.9 Z
        M6,16.5 V18.9 M9,16.5 V18.9 M12,16.5 V18.9 M15,16.5 V18.9 M18,16.5 V18.9
    </Geometry>

    <!-- NET：上下双箭头 -->
    <Geometry x:Key="IconNet">
        M7.5,19.5 V5.1 M4.4,8.2 L7.5,5.1 L10.6,8.2
        M16.5,4.5 V18.9 M13.4,15.8 L16.5,18.9 L19.6,15.8
    </Geometry>

    <!-- DISK：盘体 + 盘片 + 指示灯 -->
    <Geometry x:Key="IconDisk">
        M5.1,3.9 H18.9 A2.1,2.1 0 0 1 21,6 V18 A2.1,2.1 0 0 1 18.9,20.1 H5.1
        A2.1,2.1 0 0 1 3,18 V6 A2.1,2.1 0 0 1 5.1,3.9 Z
        M7.95,10.8 A4.05,4.05 0 1 0 16.05,10.8 A4.05,4.05 0 1 0 7.95,10.8 Z
        M16.2,16.8 A0.9,0.9 0 1 0 18,16.8 A0.9,0.9 0 1 0 16.2,16.8 Z
    </Geometry>

    <!-- 进程：三行列表（R-04 未列，进程区块是 M1.4 新增的） -->
    <Geometry x:Key="IconProc">
        M3,6.6 H5.1 M3,12 H5.1 M3,17.4 H5.1
        M8.1,6.6 H21 M8.1,12 H21 M8.1,17.4 H17.4
    </Geometry>

    <!-- ============ R-05：运行状态图标 ============ -->

    <!--
        三态形状：初始化 = 空心圆环（还在等数据）、运行中 = 实心圆、降级运行 = 三角。
        R-05 原本列的是「正常圆 / 警告三角 / 危险圆带叹号」，本程序没有"危险"态
        （窗口关掉进程就退了，不存在"停止但仍在显示"），所以第三枚换成"等待"的圆环，
        三角内保留感叹号缺口，形状语义仍是警告。

        三者包络盒都归一到 21.6×21.6，配合 Stretch=Uniform 才能保证三种形状
        显示出来视觉大小一致，不会出现"降级时灯突然变小"。
    -->
    <Geometry x:Key="ShapeStateStarting">
        F0 M1.2,12 A10.8,10.8 0 1 0 22.8,12 A10.8,10.8 0 1 0 1.2,12 Z
        M6.6,12 A5.4,5.4 0 1 0 17.4,12 A5.4,5.4 0 1 0 6.6,12 Z
    </Geometry>

    <Geometry x:Key="ShapeStateRunning">
        M2.4,12 A9.6,9.6 0 1 0 21.6,12 A9.6,9.6 0 1 0 2.4,12 Z
    </Geometry>

    <Geometry x:Key="ShapeStateDegraded">
        F0 M12,1.2 L22.8,22.8 H1.2 Z
        M10.7,9 H13.3 V16.2 H10.7 Z
        M10.6,18 H13.4 V20.6 H10.6 Z
    </Geometry>

    <!--
        区块标题图标统一外观：16 DIP、1.5 描边（几何是 24 画布，缩到 16 后视觉 1.0）、
        圆角线帽/线接。Stroke 由各区块按自己的语义色给，不在这里定死。
        Margin 右边 6 是图标与标题字的间距 —— 标题左侧已有 FoldButton 的 2 单位右边距。
    -->
    <Style x:Key="BlockIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!--
        状态灯几何。DataTrigger 绑 RunStateShapeKey（"starting"/"running"/"degraded"），
        不绑 RunStateText —— 文案随时可能改，形状不能跟着文案一起静默失效。
        填充规则用路径语法的 F0（EvenOdd）：圆环的洞、三角里的感叹号都是"挖"出来的，
        不是另画一块底色。FillRule 是 Geometry 的属性、不是 Path 的，只能在路径串里给。
    -->
    <Style x:Key="RunStateShape" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource ShapeStateStarting}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RunStateShapeKey}" Value="running">
                <Setter Property="Data" Value="{StaticResource ShapeStateRunning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RunStateShapeKey}" Value="degraded">
                <Setter Property="Data" Value="{StaticResource ShapeStateDegraded}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
