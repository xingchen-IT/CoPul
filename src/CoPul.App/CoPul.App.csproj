<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CoPul</AssemblyName>
    <RootNamespace>CoPul.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      注意：这里**不能**设 InvariantGlobalization。WPF 的 Binding 会调
      XmlLanguage.GetSpecificCulture()，一旦全球化被裁掉就直接抛
      "Cannot find non-neutral culture related to 'en-us'"，窗口连 Show() 都过不去。
      采集层（CoPul.Collector）设它是安全的，因为它不碰 WPF。
    -->
    <!-- 单文件产物名就是 CoPul.exe，产品名与进程名一致，方便任务管理器里认出来 -->
    <Product>CoPul 芯脉</Product>
    <AssemblyTitle>CoPul 芯脉</AssemblyTitle>
    <Version>0.1.0</Version>
    <!--
      程序集元数据（M4.46）。这些字段不是"填着好看"：

      · 红线第 4 条要求「exe 属性、关于页、LICENSE 里的作者信息保持一致」，
        便于维权时证明同一性。之前 Company 只是默认取成了程序集名 CoPul，Copyright 是空的。
      · 用户右键 exe → 属性，第一眼看的就是这里。空白等于"来路不明的程序"，
        对 SmartScreen 之外的人为判断（论坛转发、群文件）影响很大。
      · RepositoryUrl 会进 NuGet/程序集元数据，也给 MPL-2.0 的"源码获取方式"多一条路径。
    -->
    <Company>CoPul</Company>
    <Copyright>Copyright (c) 2026 CoPul 作者（xingchen）</Copyright>
    <Description>把 CPU、GPU、内存、硬盘、网络与帧率贴在 Windows 任务栏上的轻量监控工具</Description>
    <RepositoryUrl>https://gitee.com/stardust-xingchenya/corevessel-co-pul</RepositoryUrl>
    <!--
      应用图标（R-01）。同时用作 exe 图标（资源管理器里看到的就是它）。
      由 tools/make-icon.py 生成 —— 那个脚本会被旧版 make-tray-icon.py 取代，
      现在统一一个生成器出「主图标 + 托盘深浅两版」，改设计只改一处。
    -->
    <ApplicationIcon>assets\copul.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      图标资产：运行时按路径加载（LoadImage），必须全部落到输出目录。

      · copul.ico          R-01 主图标（exe / 快捷方式 / 关于页）：深底 + 青色开口环 C
      · copul-tray-dark.ico  R-02 深色任务栏版（**无底盘**，裸环 + 琥珀块）
      · copul-tray-light.ico R-03 浅色任务栏版（深底盘 + 青环）

      托盘为什么要两版而不是一版：实测深色任务栏 #202022 上，深底盘几乎融进背景，
      整块图标溶解成一个黑方块 —— 用户认不出。深色版干脆不要底盘，裸环最清楚。
      见 App.xaml.cs 的 ResolveTrayIcon。
    -->
    <None Include="assets\copul.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\copul.ico</Link>
      <Visible>false</Visible>
    </None>
    <None Include="assets\copul-tray-dark.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\copul-tray-dark.ico</Link>
      <Visible>false</Visible>
    </None>
    <None Include="assets\copul-tray-light.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\copul-tray-light.ico</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoPul.Collector\CoPul.Collector.csproj" />
  </ItemGroup>

  <!--
    PresentMon 随包分发（Q-07：体积预算 +15MB，实际 980KB）。
    Windows 没有给帧率的 API，FPS 只能靠它的 ETW 呈现流，见 FpsProvider。
    许可证必须一起带（MIT 要求保留版权声明），运行时按 assets 目录结构
    落到 <输出目录>\presentmon\，与 FpsProvider.ResolveExePath() 的查找顺序一致。
  -->
  <ItemGroup>
    <None Include="assets\presentmon\PresentMon.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>presentmon\PresentMon.exe</Link>
      <Visible>false</Visible>
    </None>
    <None Include="assets\presentmon\LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>presentmon\LICENSE.txt</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!--
    许可协议随二进制走（专有许可：保留所有权利，禁止二次分发）。
    用户拿到 exe 时就必须能看到条款 —— 只在仓库里放 LICENSE 是不够的，
    下载站/网盘转手一趟，仓库就不在原地了。
    Windows 上多数编辑器认不出无扩展名的 LICENSE，落到输出目录时补成 LICENSE.txt。
  -->
  <ItemGroup>
    <None Include="..\..\LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LICENSE.txt</Link>
      <Visible>false</Visible>
    </None>
    <!-- 第三方组件清单：MPL-2.0 要求告知接收者如何取得源码，MIT 要求保留声明 -->
    <None Include="..\..\THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>THIRD-PARTY-NOTICES.txt</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!--
    许可协议正文**同时**嵌入程序集（Sdk/Eula.cs 读它显示在首启弹窗里）。

    为什么不用运行时去读上面那个 LICENSE.txt：一旦文件被删（精简部署、用户清理目录），
    弹窗就只剩一句摘要 —— 而那恰好是最需要完整条款的时刻。
    LogicalName 写死成 CoPul.App.EULA.txt，不带资源文化后缀，免得发布多语言时找不到。
    文本仍取自仓库根的 LICENSE，**不复制一份**：两份正文迟早会不一致，而协议不一致比没有协议更危险。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE">
      <LogicalName>CoPul.App.EULA.txt</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
    <!--
      第三方组件清单也嵌一份（关于页读它）。同样不复制正文，仍取自仓库根的同一个文件。

      为什么清单要嵌而不是运行时读那份 txt：MPL-2.0 §3.2 要求以可执行形式分发时**告知接收者
      如何取得源码**。文件在精简部署里可能不存在，那时关于页会空一块 —— 而"清单读不到"
      恰恰是最不能沉默的情形。落盘的 THIRD-PARTY-NOTICES.txt 照旧保留，给人读、给工具核对。
    -->
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt">
      <LogicalName>CoPul.App.THIRD-PARTY-NOTICES.txt</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

</Project>
