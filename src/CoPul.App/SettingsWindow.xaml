<Window x:Class="CoPul.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoPul 设置" Width="800" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBg}" FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        这里写 CornerRadius="0" 不是忘了改：WindowChrome.CornerRadius 只在 Win8/8.1 生效，
        Win10/11 上窗口的圆角由 DWMWA_WINDOW_CORNER_PREFERENCE 决定（见 SettingsWindow.xaml.cs
        的 OnSourceInitialized）。写个非 0 值只会让人误以为"改这里就能圆角"。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            设置页专用控件样式。只在这一页用，所以不进 Themes/Styles.xaml ——
            那边的样式是三个视图共用的，混进设置页专属的东西会让"改一处"
            变成"全程序都要重新验一遍"。
        -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            分段选择（显示模式 / 缩放 / 取色）。用 RadioButton 而不是按钮组：
            选中态由 WPF 自己维护，不需要在代码里手动复位其余几个。

            M4.28：选中态从"只换底色"改成"底 + 1px 描边"，最小可点高度定到 28。
            原来选中与未选中的差别只有一档底色（#1E262F vs 透明），
            在一排里几乎看不出来，整组看起来像四个纯文字。
        -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="12,5" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushStroke}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            视图开关（M4.29）。这里原来是 RadioButton + GroupName="mode" 的互斥三选一，
            三视图可叠加之后它就成了整个程序里唯一还在表达"只能选一个"的地方。

            更麻烦的是 RadioButton 的语义：点已经选中的那一项**连 Checked 都不触发**，
            所以"再点一次收起"这条根本没地方挂。改成 ToggleButton + 实心圆点：
            实心 = 正在显示，空心灰字 = 已收起，点一下翻一次。
        -->
        <Style x:Key="ViewChip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="ToolTipService.ShowDuration" Value="8000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,6,14,6"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Fill="Transparent"
                                         Stroke="{StaticResource BrushTextTertiary}" StrokeThickness="1" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            </Trigger>
                            <!-- 后写的覆盖先写的：悬停态不能把"已显示"的样子压回灰字 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushStroke}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentCpu}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentCpu}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关。轨道 38x20、滑块 14，够在 100% 缩放下点到（10.4 最小可点 28x28，
             这里外层 Border 加了 4 的透明边距把热区撑到 28 高）。 -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Cursor" Value="Arrow" />
            <!-- 负左边距抵消模板里那 4px 透明热区：开关改成左对齐之后（M4.28），
                 不留这一手会让它比同一列的其它控件右移 4px -->
            <Setter Property="Margin" Value="-4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Hit" Background="Transparent" Padding="4" CornerRadius="4">
                            <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                    Background="{StaticResource BrushTrack}">
                                <Ellipse x:Name="Knob" Width="14" Height="14"
                                         Fill="{StaticResource BrushTextSecondary}"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGpu}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BrushTextPrimary}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字段勾选。做成 16px 方块 + 勾，比 ToggleButton 更适合横排八项 -->
        <Style x:Key="FieldCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,16,10" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">
                                <TextBlock x:Name="Tick" Text="✓" FontSize="11"
                                           Foreground="{StaticResource BrushBg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGpu}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentGpu}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushTextTertiary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小按钮（应用 / 刷新 / 打开目录） -->
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Padding 必须走 TemplateBinding：写死 12,5 的话，
                             StepButton 那种 28px 宽的按钮会被内边距吃光内容区，
                             表现为"按钮里只有一个点"（第一版就这样）。 -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                BorderBrush="{StaticResource BrushStroke}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步进器上的 - / + 。用 ASCII 而不是 U+2212 / 全角＋：两者在 Segoe UI 下
             实测渲染成空白方块（方框在、字没有），换成 ASCII 后正常。 -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource FontNumeric}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushBg}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 左侧导航项。选中时左侧一道 3px 强调条，比整块反白更克制（10.3） -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bd" Background="Transparent" Padding="18,9">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <!-- 强调条写在 Bd 之后：Bd 选中时会铺一层底色，画在它前面就整根被盖掉了 -->
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentGpu}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            字段选择条里的一格（M4.20）。用 RadioButton 是为了让 WPF 自己管互斥，
            外层描边表示"正在编辑这一格"。字色由代码按该字段当前的颜色染 ——
            九个格子只改了三格时，"哪几格改过"不能靠记。
        -->
        <Style x:Key="FieldChip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4,10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="ToolTipService.ShowDuration" Value="8000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushPanel}"
                                BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource BrushTextTertiary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource AccentGpu}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            字段开关（M4.25）。形状与 FieldChip 一致，但语义是"显示 / 隐藏"而不是"选中哪一格"，
            所以用 ToggleButton（多选）而不是 RadioButton（互斥）。

            熄灭态画成**灰字 + 删除线 + 透明底**：只调深浅的话，深色主题下"关掉的字段"
            和"没选中的色板"长得一样（M4.19 已经踩过一次这种"两种状态一个样"的坑）。
            删除线是这里唯一不依赖颜色的状态标记。
        -->
        <Style x:Key="FieldToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4,10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="ToolTipService.ShowDuration" Value="8000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushPanel}"
                                BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">
                            <!--
                                不用 ContentPresenter：熄灭态要给文字加删除线，而删除线挂在
                                TextBlock 自己身上（TextBlock.TextDecorations 不是可继承属性）。
                                Content 只放字符串，{TemplateBinding Content} 的类型转换是安全的。
                            -->
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource BrushTextTertiary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Strikethrough" />
                            </Trigger>
                            <!-- 只剩一个字段时置灰：让"不能再关"看得见，而不是点了没反应 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            色板方块（M4.19）。用 RadioButton + Tag 存 #RRGGBB，与「缩放 / 取色」同一套：
            选中态交给 WPF 互斥，代码只在 Checked 里读 Tag。
            选中标记画成外圈描边而不是方块内的勾 —— 深色色块里放一个勾几乎看不见。
        -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushStroke}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="ToolTipService.ShowDuration" Value="8000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Border x:Name="Ring" CornerRadius="5" Padding="2"
                                    BorderBrush="Transparent" BorderThickness="2">
                                <Grid>
                                    <Border x:Name="Chip" CornerRadius="3"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                                    <!-- 「自动」那一格要写个字，否则它就是个来历不明的灰块 -->
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.FontSize="11"
                                                      TextBlock.Foreground="{StaticResource BrushTextSecondary}" />
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush"
                                        Value="{StaticResource BrushTextTertiary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush"
                                        Value="{StaticResource AccentGpu}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BrushStroke}" BorderThickness="1"
            Background="{StaticResource BrushBg}" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="CoPul" Style="{StaticResource TextBrand}" />
                    <TextBlock Text="设置" Style="{StaticResource TextBrandSub}" />
                </StackPanel>
                <Button Style="{StaticResource TitleBarCloseButton}" Content="✕"
                        ToolTip="关闭" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0" Click="Close_Click" />
                <!-- 与主窗口一致的头部收边线 -->
                <Border Height="1" VerticalAlignment="Bottom"
                        Background="{StaticResource BrushDivider}" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    左侧导航（M4.28）。原来版本号紧跟在两个导航项后面，
                    下面拖着 400px 的空板 —— 一眼看过去像"还没做完的骨架"。
                    现在把版本号 Dock 到底部，上面只留导航，空白落在语义正确的位置。
                -->
                <Border Grid.Column="0" Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,1,1,0">
                    <DockPanel>
                        <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom"
                                   Style="{StaticResource SectionHint}"
                                   Margin="18,0,16,16" Text="版本" />
                        <StackPanel Margin="0,10,0,0">
                            <RadioButton x:Name="NavGeneral" Style="{StaticResource NavButton}"
                                         Content="常规" GroupName="nav" IsChecked="True"
                                         Tag="general" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavDiag" Style="{StaticResource NavButton}"
                                         Content="传感器诊断" GroupName="nav"
                                         Tag="diag" Checked="Nav_Checked" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===================== 常规 ===================== -->
                <ScrollViewer x:Name="GeneralPage" Grid.Column="1" Padding="16,6,16,16"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 显示视图（M4.29：三个开关，不再是互斥三选一） -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="显示视图" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ToggleButton x:Name="ModeMain" Style="{StaticResource ViewChip}"
                                                  Content="大窗口" Tag="main" Click="Mode_Clicked"
                                                  ToolTip="点亮 = 显示，再点一次收起" />
                                    <ToggleButton x:Name="ModeFloat" Style="{StaticResource ViewChip}"
                                                  Content="悬浮窗" Tag="float" Click="Mode_Clicked"
                                                  ToolTip="点亮 = 显示，再点一次收起" />
                                    <ToggleButton x:Name="ModeTaskbar" Style="{StaticResource ViewChip}"
                                                  Content="任务栏条" Tag="taskbar" Click="Mode_Clicked"
                                                  ToolTip="点亮 = 显示，再点一次收起" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="三个视图可以同时开着，各自独立开关：实心点 = 正在显示，再点一次收起。三个视图共用同一份采集与配置，开关不重启采集。" />
                            </StackPanel>
                        </Border>

                        <!--
                            显示字段（M4.25 合并）。原来「任务栏条字段」与「悬浮窗字段」各占一张卡、
                            各摆一片勾选框，同一件事（哪些字段要显示）被拆在两处，
                            改完一个还得往下翻很久才能改另一个。

                            「文字颜色」已经用"先选视图 → 再看一条字段条"解决了同一形状的问题，
                            这里统一成同一套：选视图 → 一条字段条 → 点亮/熄灭。
                            **不能把两个视图的字段合成一条**：key 表顺序不同（任务栏第 6 位是
                            「网络延迟」lat，悬浮窗是 net），共用一条会按错的 key 落盘。
                        -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="显示字段" Style="{StaticResource SectionTitle}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="FieldViewFloat" Style="{StaticResource Segment}"
                                                 GroupName="fieldview" Content="悬浮窗" Tag="float"
                                                 Checked="FieldView_Changed" />
                                    <RadioButton x:Name="FieldViewTray" Style="{StaticResource Segment}"
                                                 GroupName="fieldview" Content="任务栏条" Tag="tray"
                                                 Checked="FieldView_Changed" />
                                </StackPanel>

                                <WrapPanel x:Name="FieldBar" Margin="0,10,0,0" />

                                <!-- 文案随视图切：任务栏有"让位"这套额外规则，悬浮窗没有 -->
                                <TextBlock x:Name="FieldHint" Style="{StaticResource SectionHint}" />
                            </StackPanel>
                        </Border>

                        <!-- 悬浮窗外观 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="悬浮窗外观" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="毛玻璃" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" x:Name="GlassSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Checked="GlassSwitch_Toggled" Unchecked="GlassSwitch_Toggled" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="玻璃浓度" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button x:Name="LevelDown" Style="{StaticResource StepButton}"
                                                Content="-" Click="LevelDown_Click" />
                                        <TextBlock x:Name="LevelText" Style="{StaticResource RowLabel}"
                                                   Width="56" TextAlignment="Center"
                                                   FontFamily="{StaticResource FontNumeric}"
                                                   Foreground="{StaticResource BrushTextPrimary}" />
                                        <Button x:Name="LevelUp" Style="{StaticResource StepButton}"
                                                Content="+" Click="LevelUp_Click" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="排列" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="LayoutRow" Style="{StaticResource Segment}"
                                                     GroupName="layout" Content="横向" Tag="row"
                                                     Checked="Layout_Checked" />
                                        <RadioButton x:Name="LayoutColumn" Style="{StaticResource Segment}"
                                                     GroupName="layout" Content="竖向" Tag="column"
                                                     Checked="Layout_Checked"
                                                     ToolTip="六项上下排列，文字保持横向正立" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="界面缩放" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="Scale100" Style="{StaticResource Segment}"
                                                     GroupName="scale" Content="100%" Tag="100"
                                                     Checked="Scale_Checked" />
                                        <RadioButton x:Name="Scale125" Style="{StaticResource Segment}"
                                                     GroupName="scale" Content="125%" Tag="125"
                                                     Checked="Scale_Checked" />
                                        <RadioButton x:Name="Scale150" Style="{StaticResource Segment}"
                                                     GroupName="scale" Content="150%" Tag="150"
                                                     Checked="Scale_Checked" />
                                    </StackPanel>
                                </Grid>

                                <!--
                                    边框（M4.15）：静止时那圈描边的浓度。
                                    深色玻璃上"明显"那档在深色桌面上会显出一圈白边
                                    （实测亮度 50 vs 条内 16），所以给用户自己挑，而不是替他决定。
                                -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="边框" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="EdgeNone" Style="{StaticResource Segment}"
                                                     GroupName="edge" Content="无" Tag="none"
                                                     Checked="Edge_Checked"
                                                     ToolTip="静止时不描边；悬停和拖动时仍会显示" />
                                        <RadioButton x:Name="EdgeFaint" Style="{StaticResource Segment}"
                                                     GroupName="edge" Content="淡" Tag="faint"
                                                     Checked="Edge_Checked"
                                                     ToolTip="5%：能勾出四边，但不单独成线" />
                                        <RadioButton x:Name="EdgeNormal" Style="{StaticResource Segment}"
                                                     GroupName="edge" Content="明显" Tag="normal"
                                                     Checked="Edge_Checked"
                                                     ToolTip="12%：边界最清楚，深色桌面上会显白边" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--
                            文字颜色（M4.19 整条一个色 → M4.20 逐字段，悬浮窗 / 任务栏各一套）。
                            先选视图、再选字段：九格 × 两个视图 = 18 个色，
                            每个都摆一整排色板会把设置页撑成一面墙，而用户一次只调一格。
                            字段条里的字**用它自己的颜色**显示，改了哪几格一眼看得出来。
                            深底 / 浅底两块预览必须**两段一起看**：只看大数字会以为小字也够清楚。
                        -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="文字颜色" Style="{StaticResource SectionTitle}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="InkViewFloat" Style="{StaticResource Segment}"
                                                 GroupName="inkview" Content="悬浮窗" Tag="float"
                                                 Checked="InkView_Changed"
                                                 ToolTip="悬浮窗：底色是我们自己的玻璃，深浅由主题 / 浓度档决定" />
                                    <RadioButton x:Name="InkViewTray" Style="{StaticResource Segment}"
                                                 GroupName="inkview" Content="任务栏条" Tag="tray"
                                                 Checked="InkView_Changed"
                                                 ToolTip="任务栏条：底色是系统任务栏，深浅由「文字取色」决定" />
                                </StackPanel>

                                <WrapPanel x:Name="TextFieldBar" Margin="0,10,0,0" />

                                <WrapPanel x:Name="TextSwatches" Margin="0,10,0,0" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="自定义" Style="{StaticResource RowLabel}" />
                                    <TextBox x:Name="TextHexBox" Grid.Column="1" Style="{StaticResource Input}"
                                             MaxLength="7" KeyDown="TextHexBox_KeyDown" />
                                    <Button Grid.Column="2" Style="{StaticResource MiniButton}" Content="应用"
                                            Margin="8,0,0,0" Click="ApplyTextHex_Click" />
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Height="40" CornerRadius="5" Background="{StaticResource BrushBg}"
                                            BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="PreviewValueDark" Text="60 FPS" FontSize="13"
                                                       FontWeight="SemiBold" FontFamily="{StaticResource FontNumeric}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="PreviewLabelDark" Text="31.6G" FontSize="10"
                                                       FontFamily="{StaticResource FontNumeric}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Height="40" CornerRadius="5" Background="#F2F4F7"
                                            BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="PreviewValueLight" Text="60 FPS" FontSize="13"
                                                       FontWeight="SemiBold" FontFamily="{StaticResource FontNumeric}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="PreviewLabelLight" Text="31.6G" FontSize="10"
                                                       FontFamily="{StaticResource FontNumeric}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox x:Name="TextThresholdSwitch" Style="{StaticResource FieldCheck}"
                                              Content="数值超阈值时仍变黄 / 红"
                                              Checked="TextThreshold_Toggled" Unchecked="TextThreshold_Toggled" />
                                    <Button x:Name="TextResetAll" Style="{StaticResource MiniButton}"
                                            Content="本视图全部重置" Margin="16,0,0,0"
                                            Click="ResetAllTextColors_Click"
                                            ToolTip="把当前视图九个字段都改回「自动」" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="每个字段都能单独选色，没选过的字段保持「自动」（悬浮窗跟随玻璃主题、任务栏跟随「文字取色」）。主值用所选色、次值用同色降浓度；超阈值的格子默认仍变黄 / 红，取消勾选才是整条一个颜色。两个视图各存一套。" />
                            </StackPanel>
                        </Border>

                        <!-- 悬浮窗交互（M4.21） -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="悬浮窗交互" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="锁定位置" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" x:Name="FloatLockSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Checked="FloatLockSwitch_Toggled" Unchecked="FloatLockSwitch_Toggled" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="鼠标穿透" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" x:Name="FloatThroughSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Checked="FloatThroughSwitch_Toggled" Unchecked="FloatThroughSwitch_Toggled" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="始终置顶" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" x:Name="FloatTopmostSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Checked="FloatTopmostSwitch_Toggled" Unchecked="FloatTopmostSwitch_Toggled" />
                                </Grid>

                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="穿透后悬浮窗不接收任何鼠标操作（右键菜单也会失效），关掉它的出口有三处：本页这个开关、托盘图标右键菜单、全局热键切到其他视图。开启穿透会自动锁定位置——鼠标消息根本不投递，本来也拖不动。始终置顶每秒把悬浮窗提回最顶层，能压过游戏浮层等其它置顶窗口；独占全屏的游戏不在此列。" />
                            </StackPanel>
                        </Border>

                        <!-- 任务栏条 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="任务栏条" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="文字取色" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="InkAuto" Style="{StaticResource Segment}"
                                                     GroupName="ink" Content="自动" Tag="auto"
                                                     Checked="Ink_Checked" />
                                        <RadioButton x:Name="InkLight" Style="{StaticResource Segment}"
                                                     GroupName="ink" Content="浅色底" Tag="light"
                                                     Checked="Ink_Checked" />
                                        <RadioButton x:Name="InkDark" Style="{StaticResource Segment}"
                                                     GroupName="ink" Content="深色底" Tag="dark"
                                                     Checked="Ink_Checked" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="点击穿透" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" x:Name="ThroughSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Checked="ThroughSwitch_Toggled" Unchecked="ThroughSwitch_Toggled" />
                                </Grid>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="穿透后条不接收任何鼠标操作，全部操作走托盘右键菜单。关掉它才能用条上的右键菜单调文字颜色。" />
                            </StackPanel>
                        </Border>

                        <!-- 采集与网络 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="采集与网络" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="延迟探测目标" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="PingBox" Grid.Column="1" Style="{StaticResource Input}"
                                             KeyDown="PingBox_KeyDown" />
                                    <Button Grid.Column="2" Style="{StaticResource MiniButton}" Content="应用"
                                            Margin="8,0,0,0" Click="ApplyPing_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="默认 223.5.5.5（阿里 DNS）。内网环境 ping 公网会一直超时，改成网关地址才有读数。" />

                                <!--
                                    数据刷新间隔（M4.24）：这才是"CPU/GPU 多久更新一次"的那个档位。
                                    实际间隔 = max(档位, 各指标自身的 floor)，所以调慢一定生效、
                                    调快会被 floor 钳住 —— 提示里必须说清，否则用户写 5s 生效、
                                    写 0.1s 没反应会觉得是 bug。
                                -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="刷新间隔" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="Sample500" Style="{StaticResource Segment}"
                                                     GroupName="sampleRate" Content="0.5s" Tag="500"
                                                     Checked="SampleRate_Checked"
                                                     ToolTip="默认：数值最跟手，占用也最高" />
                                        <RadioButton x:Name="Sample1000" Style="{StaticResource Segment}"
                                                     GroupName="sampleRate" Content="1s" Tag="1000"
                                                     Checked="SampleRate_Checked" />
                                        <RadioButton x:Name="Sample2000" Style="{StaticResource Segment}"
                                                     GroupName="sampleRate" Content="2s" Tag="2000"
                                                     Checked="SampleRate_Checked" />
                                        <RadioButton x:Name="Sample3000" Style="{StaticResource Segment}"
                                                     GroupName="sampleRate" Content="3s" Tag="3000"
                                                     Checked="SampleRate_Checked" />
                                        <RadioButton x:Name="Sample5000" Style="{StaticResource Segment}"
                                                     GroupName="sampleRate" Content="5s" Tag="5000"
                                                     Checked="SampleRate_Checked"
                                                     ToolTip="最省电，但数值每 5 秒才跳一次" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="CPU、GPU、内存等数据多久采一次：越慢越省电，占用近乎成正比下降。实际间隔不快于各指标自身的下限（调快会被钳住），趋势图覆盖的时间也会按比例变长。" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="全屏时自动隐藏" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" x:Name="FullScreenSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Checked="FullScreenSwitch_Toggled"
                                                  Unchecked="FullScreenSwitch_Toggled" />
                                </Grid>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="独占全屏时把悬浮窗/任务栏条收起，避免盖在游戏画面上。办公软件的放映模式也会被识别为全屏。" />

                                <!--
                                    防抖档位（M4.23）：判定主体是前台窗口，切屏、弹窗、Alt+Tab 那一瞬间
                                    都可能短暂"像全屏"。档位越长越稳，代价是切换反应变慢 —— 这个取舍
                                    只有"快 vs 稳"一句话，所以只给一个数，不拆成"进入/退出"两个去为难用户。
                                -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="切换确认" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="FsHold500" Style="{StaticResource Segment}"
                                                     GroupName="fsHold" Content="0.5s" Tag="500"
                                                     Checked="FsHold_Checked"
                                                     ToolTip="反应最快，但切屏/弹窗容易被误判" />
                                        <RadioButton x:Name="FsHold1000" Style="{StaticResource Segment}"
                                                     GroupName="fsHold" Content="1s" Tag="1000"
                                                     Checked="FsHold_Checked"
                                                     ToolTip="默认：挡得住 1 秒内的切出又回来" />
                                        <RadioButton x:Name="FsHold2000" Style="{StaticResource Segment}"
                                                     GroupName="fsHold" Content="2s" Tag="2000"
                                                     Checked="FsHold_Checked" />
                                        <RadioButton x:Name="FsHold3000" Style="{StaticResource Segment}"
                                                     GroupName="fsHold" Content="3s" Tag="3000"
                                                     Checked="FsHold_Checked"
                                                     ToolTip="最稳，但进游戏后要等 3 秒才切到悬浮窗" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="须连续全屏/非全屏这么久才切换：越长越不容易被切屏、弹窗带偏，代价是切换反应也慢一点。" />
                            </StackPanel>
                        </Border>

                        <!-- 交互 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="交互" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="全局热键" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource Input}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    <Button Grid.Column="2" Style="{StaticResource MiniButton}" Content="恢复默认"
                                            Margin="8,0,0,0" Click="HotkeyDefault_Click" />
                                </Grid>
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource SectionHint}"
                                           Text="点击输入框后直接按下组合键即可录制，Esc 取消。按一次循环切换：大窗口 → 悬浮窗 → 任务栏条。" />
                            </StackPanel>
                        </Border>

                        <!-- 启动 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="开机自动启动" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" x:Name="AutoStartSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Checked="AutoStartSwitch_Toggled"
                                                  Unchecked="AutoStartSwitch_Toggled" />
                                </Grid>
                                <TextBlock x:Name="AutoStartHint" Style="{StaticResource SectionHint}"
                                           Text="通过计划任务注册（程序需要管理员权限，Run 键会被 UAC 拦下）。首次开启会弹一次 UAC 确认。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== 传感器诊断 ===================== -->
                <Grid x:Name="DiagPage" Grid.Column="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,10,16,6">
                        <Grid>
                            <TextBlock Text="传感器诊断" Style="{StaticResource SectionTitle}" />
                            <Button Style="{StaticResource MiniButton}" Content="刷新"
                                    HorizontalAlignment="Right" Click="RefreshDiag_Click" />
                        </Grid>
                        <TextBlock x:Name="DiagSummary" Style="{StaticResource SectionHint}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DiagList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushPanel}"
                                            BorderBrush="{StaticResource BrushStroke}" BorderThickness="1"
                                            CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               Foreground="{StaticResource BrushTextPrimary}" />
                                                    <Border Background="{Binding BadgeBg}" CornerRadius="3"
                                                            Padding="6,1" Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                   Foreground="{Binding BadgeFg}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CostText}" FontSize="11"
                                                           FontFamily="{StaticResource FontMono}"
                                                           Foreground="{StaticResource BrushTextTertiary}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding ReasonText}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Visibility="{Binding ReasonVisibility}" />
                                            <TextBlock Text="{Binding RemedyText}" FontSize="11"
                                                       Foreground="{StaticResource BrushWarn}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding RemedyVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 底栏 -->
            <Border Grid.Row="2" Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <TextBlock x:Name="FooterText" Style="{StaticResource RowLabel}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextTertiary}"
                               TextTrimming="CharacterEllipsis"
                               Text="就绪" />
                    <Button x:Name="OpenConfigButton" Style="{StaticResource MiniButton}" Content="打开配置目录"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="10,3" Click="OpenConfigDir_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
