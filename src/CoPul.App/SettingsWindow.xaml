<Window x:Class="CoPul.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoPul 设置" Width="800" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBg}" FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        这里写 CornerRadius="0" 不是忘了改：WindowChrome.CornerRadius 只在 Win8/8.1 生效，
        Win10/11 上窗口的圆角由 DWMWA_WINDOW_CORNER_PREFERENCE 决定（见 SettingsWindow.xaml.cs
        的 OnSourceInitialized）。写个非 0 值只会让人误以为"改这里就能圆角"。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            设置页专用控件样式。只在这一页用，所以不进 Themes/Styles.xaml ——
            那边的样式是三个视图共用的，混进设置页专属的东西会让"改一处"
            变成"全程序都要重新验一遍"。
        -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 分段选择（显示模式 / 缩放 / 取色）。用 RadioButton 而不是按钮组：
             选中态由 WPF 自己维护，不需要在代码里手动复位其余几个。 -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Padding="14,6" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关。轨道 38x20、滑块 14，够在 100% 缩放下点到（10.4 最小可点 28x28，
             这里外层 Border 加了 4 的透明边距把热区撑到 28 高）。 -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Hit" Background="Transparent" Padding="4" CornerRadius="4">
                            <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                    Background="{StaticResource BrushTrack}">
                                <Ellipse x:Name="Knob" Width="14" Height="14"
                                         Fill="{StaticResource BrushTextSecondary}"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGpu}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BrushTextPrimary}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字段勾选。做成 16px 方块 + 勾，比 ToggleButton 更适合横排八项 -->
        <Style x:Key="FieldCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,16,10" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">
                                <TextBlock x:Name="Tick" Text="✓" FontSize="11"
                                           Foreground="{StaticResource BrushBg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGpu}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentGpu}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushTextTertiary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小按钮（应用 / 刷新 / 打开目录） -->
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Padding 必须走 TemplateBinding：写死 12,5 的话，
                             StepButton 那种 28px 宽的按钮会被内边距吃光内容区，
                             表现为"按钮里只有一个点"（第一版就这样）。 -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                BorderBrush="{StaticResource BrushStroke}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步进器上的 - / + 。用 ASCII 而不是 U+2212 / 全角＋：两者在 Segoe UI 下
             实测渲染成空白方块（方框在、字没有），换成 ASCII 后正常。 -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource FontNumeric}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushBg}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 左侧导航项。选中时左侧一道 3px 强调条，比整块反白更克制（10.3） -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                    Background="Transparent" />
                            <Border x:Name="Bd" Background="Transparent" Padding="18,9">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanelHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentGpu}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BrushStroke}" BorderThickness="1"
            Background="{StaticResource BrushBg}" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="CoPul" Style="{StaticResource TextBrand}" />
                    <TextBlock Text="设置" Style="{StaticResource TextBrandSub}" />
                </StackPanel>
                <Button Style="{StaticResource TitleBarCloseButton}" Content="✕"
                        ToolTip="关闭" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,1,1,0">
                    <StackPanel Margin="0,10,0,0">
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavButton}"
                                     Content="常规" GroupName="nav" IsChecked="True"
                                     Tag="general" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavDiag" Style="{StaticResource NavButton}"
                                     Content="传感器诊断" GroupName="nav"
                                     Tag="diag" Checked="Nav_Checked" />

                        <TextBlock x:Name="VersionText" Style="{StaticResource SectionHint}"
                                   Margin="18,24,14,0" Text="版本" />
                    </StackPanel>
                </Border>

                <!-- ===================== 常规 ===================== -->
                <ScrollViewer x:Name="GeneralPage" Grid.Column="1" Padding="16,6,16,16"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 显示模式 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="显示模式" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="ModeMain" Style="{StaticResource Segment}"
                                                 GroupName="mode" Content="大窗口" Tag="main"
                                                 Checked="Mode_Checked" />
                                    <RadioButton x:Name="ModeFloat" Style="{StaticResource Segment}"
                                                 GroupName="mode" Content="悬浮窗" Tag="float"
                                                 Checked="Mode_Checked" />
                                    <RadioButton x:Name="ModeTaskbar" Style="{StaticResource Segment}"
                                                 GroupName="mode" Content="任务栏条" Tag="taskbar"
                                                 Checked="Mode_Checked" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="三个视图共用同一份采集与配置，切换不重启采集。" />
                            </StackPanel>
                        </Border>

                        <!-- 任务栏字段 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="任务栏条字段" Style="{StaticResource SectionTitle}" />
                                <UniformGrid x:Name="FieldGrid" Columns="4" Margin="0,12,0,0" />
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="关闭的字段不占位，条会跟着收缩。任务栏空白不够时，按「功耗 → 延迟 → 网络速率」的顺序临时让位（FPS 留到最后），让位不写入配置，空白恢复后自动长回来。只剩一个字段时该项不可关闭。" />
                            </StackPanel>
                        </Border>

                        <!-- 悬浮窗外观 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="悬浮窗外观" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="毛玻璃" Style="{StaticResource RowLabel}" />
                                    <ToggleButton x:Name="GlassSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="GlassSwitch_Toggled" Unchecked="GlassSwitch_Toggled" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="玻璃浓度" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="LevelDown" Style="{StaticResource StepButton}"
                                                Content="-" Click="LevelDown_Click" />
                                        <TextBlock x:Name="LevelText" Style="{StaticResource RowLabel}"
                                                   Width="56" TextAlignment="Center"
                                                   FontFamily="{StaticResource FontNumeric}"
                                                   Foreground="{StaticResource BrushTextPrimary}" />
                                        <Button x:Name="LevelUp" Style="{StaticResource StepButton}"
                                                Content="+" Click="LevelUp_Click" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="排列" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <RadioButton x:Name="LayoutRow" Style="{StaticResource Segment}"
                                                 GroupName="layout" Content="横向" Tag="row"
                                                 Checked="Layout_Checked" />
                                    <RadioButton x:Name="LayoutColumn" Style="{StaticResource Segment}"
                                                 GroupName="layout" Content="竖向" Tag="column"
                                                 Checked="Layout_Checked"
                                                 ToolTip="六项上下排列，文字保持横向正立" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="界面缩放" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <RadioButton x:Name="Scale100" Style="{StaticResource Segment}"
                                                 GroupName="scale" Content="100%" Tag="100"
                                                 Checked="Scale_Checked" />
                                    <RadioButton x:Name="Scale125" Style="{StaticResource Segment}"
                                                 GroupName="scale" Content="125%" Tag="125"
                                                 Checked="Scale_Checked" />
                                    <RadioButton x:Name="Scale150" Style="{StaticResource Segment}"
                                                 GroupName="scale" Content="150%" Tag="150"
                                                 Checked="Scale_Checked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 任务栏条 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="任务栏条" Style="{StaticResource SectionTitle}" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="文字取色" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <RadioButton x:Name="InkAuto" Style="{StaticResource Segment}"
                                                 GroupName="ink" Content="自动" Tag="auto"
                                                 Checked="Ink_Checked" />
                                    <RadioButton x:Name="InkLight" Style="{StaticResource Segment}"
                                                 GroupName="ink" Content="浅色底" Tag="light"
                                                 Checked="Ink_Checked" />
                                    <RadioButton x:Name="InkDark" Style="{StaticResource Segment}"
                                                 GroupName="ink" Content="深色底" Tag="dark"
                                                 Checked="Ink_Checked" />
                                </StackPanel>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="点击穿透" Style="{StaticResource RowLabel}" />
                                    <ToggleButton x:Name="ThroughSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="ThroughSwitch_Toggled" Unchecked="ThroughSwitch_Toggled" />
                                </Grid>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="穿透后条不接收任何鼠标操作，全部操作走托盘右键菜单。关掉它才能用条上的右键菜单调文字颜色。" />
                            </StackPanel>
                        </Border>

                        <!-- 采集与网络 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="采集与网络" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="延迟探测目标" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox x:Name="PingBox" Grid.Column="1" Style="{StaticResource Input}"
                                             KeyDown="PingBox_KeyDown" />
                                    <Button Grid.Column="2" Style="{StaticResource MiniButton}" Content="应用"
                                            Margin="8,0,0,0" Click="ApplyPing_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="默认 223.5.5.5（阿里 DNS）。内网环境 ping 公网会一直超时，改成网关地址才有读数。" />

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="全屏时自动隐藏" Style="{StaticResource RowLabel}" />
                                    <ToggleButton x:Name="FullScreenSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="FullScreenSwitch_Toggled"
                                                  Unchecked="FullScreenSwitch_Toggled" />
                                </Grid>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="独占全屏时把悬浮窗/任务栏条收起，避免盖在游戏画面上。办公软件的放映模式也会被识别为全屏。" />
                            </StackPanel>
                        </Border>

                        <!-- 交互 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="交互" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="全局热键" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource Input}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    <Button Grid.Column="2" Style="{StaticResource MiniButton}" Content="恢复默认"
                                            Margin="8,0,0,0" Click="HotkeyDefault_Click" />
                                </Grid>
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource SectionHint}"
                                           Text="点击输入框后直接按下组合键即可录制，Esc 取消。按一次循环切换：大窗口 → 悬浮窗 → 任务栏条。" />
                            </StackPanel>
                        </Border>

                        <!-- 启动 -->
                        <Border Style="{StaticResource BlockCard}">
                            <StackPanel>
                                <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="开机自动启动" Style="{StaticResource RowLabel}" />
                                    <ToggleButton x:Name="AutoStartSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="AutoStartSwitch_Toggled"
                                                  Unchecked="AutoStartSwitch_Toggled" />
                                </Grid>
                                <TextBlock x:Name="AutoStartHint" Style="{StaticResource SectionHint}"
                                           Text="通过计划任务注册（程序需要管理员权限，Run 键会被 UAC 拦下）。首次开启会弹一次 UAC 确认。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== 传感器诊断 ===================== -->
                <Grid x:Name="DiagPage" Grid.Column="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,10,16,6">
                        <Grid>
                            <TextBlock Text="传感器诊断" Style="{StaticResource SectionTitle}" />
                            <Button Style="{StaticResource MiniButton}" Content="刷新"
                                    HorizontalAlignment="Right" Click="RefreshDiag_Click" />
                        </Grid>
                        <TextBlock x:Name="DiagSummary" Style="{StaticResource SectionHint}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DiagList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushPanel}"
                                            BorderBrush="{StaticResource BrushStroke}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               Foreground="{StaticResource BrushTextPrimary}" />
                                                    <Border Background="{Binding BadgeBg}" CornerRadius="3"
                                                            Padding="6,1" Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                   Foreground="{Binding BadgeFg}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CostText}" FontSize="11"
                                                           FontFamily="{StaticResource FontMono}"
                                                           Foreground="{StaticResource BrushTextTertiary}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding ReasonText}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Visibility="{Binding ReasonVisibility}" />
                                            <TextBlock Text="{Binding RemedyText}" FontSize="11"
                                                       Foreground="{StaticResource BrushWarn}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding RemedyVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 底栏 -->
            <Border Grid.Row="2" Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <TextBlock x:Name="FooterText" Style="{StaticResource RowLabel}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextTertiary}"
                               TextTrimming="CharacterEllipsis"
                               Text="就绪" />
                    <Button x:Name="OpenConfigButton" Style="{StaticResource MiniButton}" Content="打开配置目录"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="10,3" Click="OpenConfigDir_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
