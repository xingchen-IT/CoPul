<Window x:Class="CoPul.App.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoPul 许可协议 · GPL-3.0" Width="720" Height="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource BrushBg}" FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        首次启动的许可协议窗（2026-11-04 立；2026-11-05 切换 GPL-3.0 后改语义）。

        为什么不是一个 MessageBox：条款全文（GPL-3.0 正文 674 行）必须可滚动、可回看、
        可复制；MessageBox 里既滚不了也选不中，等于"给了一个看不见的条款"。

        为什么还留着这个窗：GPL-3.0 第 9 条写明运行程序不需要接受许可，所以它不再是
        点击合同，只是**一次性的告知** —— 让用户知道拿到的是自由软件、可以再分发。
        勾选框保留，但措辞是"我已阅读"而非"我同意"，不构成对 GPL 授予权利的任何限缩。

        Topmost：实测在全屏游戏正在跑时启动本程序，ShowDialog 抢不到前台，窗口被压在
        游戏后面 —— 用户看到的是"点了图标什么都没发生"，进程却一直停在这里等确认。
        这是一次性的告知窗（装完只出现一次），压过别人比静默卡住更可接受。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 与设置页一致的按钮外观。这里复制一份而不是抽到共用资源里：
             共用样式一改，三个视图和设置页都要重新验一遍（M4.28 的教训）。 -->
        <Style x:Key="EulaButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPanelHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            主按钮。前景用 BrushBg 而不是写死白色：深色主题的强调色是浅青（#4FB3A6），
            白字压上去几乎看不清；浅色主题的强调色是深青，白字才够。BrushBg 恰好两边都反相，
            一个绑定同时满足两套主题，不用维护第二套颜色。
        -->
        <Style x:Key="EulaPrimary" TargetType="Button" BasedOn="{StaticResource EulaButton}">
            <Setter Property="Foreground" Value="{DynamicResource BrushBg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentGpu}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushStroke}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EulaCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="Transparent" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                                <TextBlock x:Name="Tick" Text="✓" FontSize="11"
                                           Foreground="{DynamicResource BrushBg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentGpu}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentGpu}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushTextTertiary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1"
            Background="{DynamicResource BrushBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：整条可拖动（WindowStyle=None 之后没有系统标题栏可拖） -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CoPul" Style="{StaticResource TextBrand}" />
                    <TextBlock Text="许可协议" Style="{StaticResource TextBrandSub}" />
                    <Border Width="1" Height="12" Margin="12,0" VerticalAlignment="Center"
                            Background="{DynamicResource BrushDivider}" />
                    <TextBlock x:Name="VersionText" Text="版本 2 · 2026-11-05 生效"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextTertiary}" />
                </StackPanel>
                <Button Style="{StaticResource TitleBarCloseButton}" Content="✕"
                        ToolTip="关闭并退出" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="Decline_Click" />
                <Border Height="1" VerticalAlignment="Bottom"
                        Background="{DynamicResource BrushDivider}" />
            </Grid>

            <!-- 正文：必须可滚动，条款全文在这里 -->
            <Border Grid.Row="1" Margin="20,16,20,0" CornerRadius="6"
                    Background="{DynamicResource BrushPanel}"
                    BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="18,14,10,14">
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontUi}" FontSize="12"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </ScrollViewer>
            </Border>

            <!-- 底部：勾选 + 两个动作 -->
            <Grid x:Name="FooterRow" Grid.Row="2" Margin="20,14,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="ConsentCheck" Grid.Row="0" Style="{StaticResource EulaCheck}"
                          Content="我已阅读上述条款"
                          Checked="Consent_Changed" Unchecked="Consent_Changed" />

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FootNote" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource BrushTextTertiary}"
                               Text="GPL-3.0 已直接授予你运行、修改与再分发的权利；这里的勾选只表示已阅读。完整条款见随包的 LICENSE.txt。" />

                    <Button Grid.Column="1" x:Name="DeclineButton" Style="{StaticResource EulaButton}"
                            Content="退出" MinWidth="88" Margin="12,0,0,0" Click="Decline_Click" />

                    <Button Grid.Column="2" x:Name="AcceptButton" Style="{StaticResource EulaPrimary}"
                            Content="继续" MinWidth="112" Margin="10,0,0,0"
                            IsEnabled="False" IsDefault="True" Click="Accept_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
